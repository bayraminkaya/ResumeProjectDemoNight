@model ResumeProjectDemoNight.Entities.About

@{
    ViewData["Title"] = "AboutList";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    bool isEdit = Model != null && Model.AboutId > 0;
}

<div class="p-6 max-w-5xl mx-auto">
    <!-- Header -->
    <div class="mb-8">
        <h1 class="text-2xl font-bold text-white mb-1">Hakkımda</h1>
        <p class="text-gray-400 text-sm">Hakkımda bölümünüzü buradan düzenleyebilirsiniz.</p>
    </div>

    <form asp-action="AboutList" asp-controller="About" method="post" class="space-y-6">
        @if (isEdit)
        {
            <input type="hidden" asp-for="AboutId" />
        }

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Sol Taraf - Profil Kartı -->
            <div class="lg:col-span-1">
                <div class="bg-gray-800/50 backdrop-blur-sm border border-gray-700/50 rounded-xl p-6 sticky top-6">
                    <h2 class="text-lg font-semibold text-white mb-4 flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-cyan-400" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z" clip-rule="evenodd" />
                        </svg>
                        Profil Önizleme
                    </h2>

                    <!-- Image Preview -->
                    <div class="relative group mb-4">
                        <div class="aspect-square rounded-xl overflow-hidden bg-gray-900/50 border-2 border-dashed border-gray-600 flex items-center justify-center">
                            <img id="imagePreview"
                                 src="@(Model?.ImageUrl ?? "")"
                                 alt="Profil Resmi"
                                 class="w-full h-full object-cover @(string.IsNullOrEmpty(Model?.ImageUrl) ? "hidden" : "")"
                                 onerror="this.classList.add('hidden'); document.getElementById('imagePlaceholder').classList.remove('hidden');">
                            <div id="imagePlaceholder" class="text-center p-4 @(!string.IsNullOrEmpty(Model?.ImageUrl) ? "hidden" : "")">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 text-gray-600 mx-auto mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                </svg>
                                <p class="text-gray-500 text-sm">Resim URL'si girin</p>
                            </div>
                        </div>
                    </div>

                    <!-- Name Preview -->
                    <div class="text-center">
                        <h3 id="namePreview" class="text-xl font-bold text-white mb-1">
                            @(Model?.NameSurname ?? "Ad Soyad")
                        </h3>
                        <p class="text-cyan-400 text-sm font-medium">Full Stack Developer</p>
                    </div>
                </div>
            </div>

            <!-- Sağ Taraf - Form -->
            <div class="lg:col-span-2 space-y-6">
                <!-- Kişisel Bilgiler Kartı -->
                <div class="bg-gray-800/50 backdrop-blur-sm border border-gray-700/50 rounded-xl p-6">
                    <h2 class="text-lg font-semibold text-white mb-6 flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-cyan-400" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd" />
                        </svg>
                        Kişisel Bilgiler
                    </h2>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <!-- Ad Soyad -->
                        <div>
                            <label class="block text-sm font-medium text-gray-300 mb-2">
                                Ad Soyad <span class="text-red-400">*</span>
                            </label>
                            <input type="text"
                                   asp-for="NameSurname"
                                   id="nameInput"
                                   placeholder="Adınız ve soyadınız"
                                   class="w-full bg-gray-900/50 border border-gray-600 rounded-lg px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 transition-all duration-200"
                                   required>
                        </div>

                        <!-- Resim URL -->
                        <div>
                            <label class="block text-sm font-medium text-gray-300 mb-2">
                                Profil Resmi URL'si <span class="text-red-400">*</span>
                            </label>
                            <input type="url"
                                   asp-for="ImageUrl"
                                   id="imageInput"
                                   placeholder="https://example.com/image.jpg"
                                   class="w-full bg-gray-900/50 border border-gray-600 rounded-lg px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 transition-all duration-200"
                                   required>
                        </div>
                    </div>
                </div>

                <!-- Açıklama Kartı -->
                <div class="bg-gray-800/50 backdrop-blur-sm border border-gray-700/50 rounded-xl p-6">
                    <h2 class="text-lg font-semibold text-white mb-6 flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-cyan-400" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h8a2 2 0 012 2v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4zm3 1h6v4H7V5zm6 6H7v2h6v-2z" clip-rule="evenodd" />
                        </svg>
                        Açıklama Metni
                    </h2>

                    <!-- Description -->
                    <div class="mb-6">
                        <label class="block text-sm font-medium text-gray-300 mb-2">
                            Kısa Açıklama <span class="text-red-400">*</span>
                        </label>
                        <textarea asp-for="Description"
                                  rows="4"
                                  placeholder="C#, ASP.NET Core, SQL Server ve React teknolojilerini kullanarak..."
                                  class="w-full bg-gray-900/50 border border-gray-600 rounded-lg px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 transition-all duration-200 resize-none"
                                  required></textarea>
                        <p class="text-gray-500 text-xs mt-2">Ana sayfada görünecek açıklama metni</p>
                    </div>

                    <!-- Slider -->
                    <div>
                        <label class="block text-sm font-medium text-gray-300 mb-2">
                            Slider Metni
                        </label>
                        <textarea asp-for="Slider"
                                  rows="3"
                                  placeholder="Full Stack Developer'ım, Modern web uygulamaları geliştiriyorum..."
                                  class="w-full bg-gray-900/50 border border-gray-600 rounded-lg px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 transition-all duration-200 resize-none"></textarea>
                        <p class="text-gray-500 text-xs mt-2">Slider alanında görünecek kısa tanıtım metni</p>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="flex flex-col sm:flex-row gap-4">
                    <button type="submit"
                            class="flex-1 inline-flex items-center justify-center gap-2 bg-gradient-to-r from-cyan-500 to-teal-500 hover:from-cyan-600 hover:to-teal-600 text-white font-semibold px-6 py-3.5 rounded-xl transition-all duration-200 shadow-lg shadow-cyan-500/25 hover:shadow-cyan-500/40">
                        @if (isEdit)
                        {
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                                <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" />
                            </svg>
                            <span>Değişiklikleri Kaydet</span>
                        }
                        else
                        {
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
                            </svg>
                            <span>Kaydet</span>
                        }
                    </button>

                    <button type="button"
                            id="resetButton"
                            class="sm:w-auto inline-flex items-center justify-center gap-2 bg-gray-700 hover:bg-gray-600 text-gray-300 font-medium px-6 py-3.5 rounded-xl transition-all duration-200">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M4 2a1 1 0 011 1v2.101a7.002 7.002 0 0111.601 2.566 1 1 0 11-1.885.666A5.002 5.002 0 005.999 7H9a1 1 0 010 2H4a1 1 0 01-1-1V3a1 1 0 011-1zm.008 9.057a1 1 0 011.276.61A5.002 5.002 0 0014.001 13H11a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0v-2.101a7.002 7.002 0 01-11.601-2.566 1 1 0 01.61-1.276z" clip-rule="evenodd" />
                        </svg>
                        Sıfırla
                    </button>
                </div>

                <!-- Success/Error Messages -->
                @if (TempData["Success"] != null)
                {
                    <div class="bg-green-500/10 border border-green-500/50 rounded-xl p-4 flex items-center gap-3">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-green-400 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                        </svg>
                        <span class="text-green-400">@TempData["Success"]</span>
                    </div>
                }

                @if (TempData["Error"] != null)
                {
                    <div class="bg-red-500/10 border border-red-500/50 rounded-xl p-4 flex items-center gap-3">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-red-400 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                        </svg>
                        <span class="text-red-400">@TempData["Error"]</span>
                    </div>
                }
            </div>
        </div>
    </form>
</div>

<!-- Live Preview Script -->
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const nameInput = document.getElementById('nameInput');
        const imageInput = document.getElementById('imageInput');
        const descriptionInput = document.querySelector('textarea[name="Description"]');
        const sliderInput = document.querySelector('textarea[name="Slider"]');
        const namePreview = document.getElementById('namePreview');
        const imagePreview = document.getElementById('imagePreview');
        const imagePlaceholder = document.getElementById('imagePlaceholder');
        const resetButton = document.getElementById('resetButton');

        // Orijinal değerleri sakla
        const originalValues = {
            name: nameInput?.value || '',
            image: imageInput?.value || '',
            description: descriptionInput?.value || '',
            slider: sliderInput?.value || ''
        };

        // Name preview
        nameInput?.addEventListener('input', function() {
            namePreview.textContent = this.value || 'Ad Soyad';
        });

        // Image preview
        function updateImagePreview(url) {
            if (url) {
                imagePreview.src = url;
                imagePreview.classList.remove('hidden');
                imagePlaceholder.classList.add('hidden');

                imagePreview.onerror = function() {
                    imagePreview.classList.add('hidden');
                    imagePlaceholder.classList.remove('hidden');
                };
            } else {
                imagePreview.classList.add('hidden');
                imagePlaceholder.classList.remove('hidden');
            }
        }

        imageInput?.addEventListener('input', function() {
            updateImagePreview(this.value);
        });

        // Sıfırla butonu
        resetButton?.addEventListener('click', function() {
            // Form değerlerini geri yükle
            if (nameInput) nameInput.value = originalValues.name;
            if (imageInput) imageInput.value = originalValues.image;
            if (descriptionInput) descriptionInput.value = originalValues.description;
            if (sliderInput) sliderInput.value = originalValues.slider;

            // Önizlemeleri güncelle
            namePreview.textContent = originalValues.name || 'Ad Soyad';
            updateImagePreview(originalValues.image);
        });
    });
</script>