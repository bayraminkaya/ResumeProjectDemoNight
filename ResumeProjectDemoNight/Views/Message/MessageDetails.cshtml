@model ResumeProjectDemoNight.Entities.Message
@{
    ViewData["Title"] = "Mesaj Detayı";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="min-h-screen p-6 lg:p-8">
    <div class="max-w-4xl mx-auto">

        <!-- Header -->
        <div class="mb-8">
            <a href="/Message/MessageList/" class="inline-flex items-center gap-2 text-gray-400 hover:text-white transition-colors mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
                </svg>
                Mesajlara Dön
            </a>
            <div class="flex items-center gap-3">
                <div class="w-12 h-12 bg-gradient-to-br from-indigo-500 to-purple-600 rounded-2xl flex items-center justify-center shadow-lg shadow-indigo-500/30">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                </div>
                <div>
                    <h1 class="text-2xl font-bold text-white">Mesaj Detayı</h1>
                    <p class="text-gray-400 text-sm">@Model.Subject</p>
                </div>
            </div>
        </div>

        <!-- Message Card -->
        <div class="bg-gray-800/40 backdrop-blur-sm border border-gray-700/50 rounded-2xl overflow-hidden">

            <!-- Sender Info -->
            <div class="p-6 border-b border-gray-700/50">
                <div class="flex items-start justify-between">
                    <div class="flex items-center gap-4">
                        <div class="w-14 h-14 rounded-full bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center text-white font-bold text-xl">
                            @Model.NameSurname.Substring(0, 1).ToUpper()
                        </div>
                        <div>
                            <h3 class="text-lg font-semibold text-white">@Model.NameSurname</h3>
                            <a href="mailto:@Model.Email" class="text-indigo-400 text-sm hover:underline">@Model.Email</a>
                        </div>
                    </div>

                    <div class="text-right">
                        <div class="flex items-center gap-2 text-gray-400 text-sm">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" />
                            </svg>
                            @Model.SendDate.ToString("dd MMMM yyyy, HH:mm")
                        </div>
                        @if (Model.IsRead)
                        {
                            <span class="inline-flex items-center gap-1 mt-2 px-2 py-1 bg-emerald-500/10 text-emerald-400 text-xs rounded-full">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                                </svg>
                                Okundu
                            </span>
                        }
                        else
                        {
                            <span class="inline-flex items-center gap-1 mt-2 px-2 py-1 bg-indigo-500/20 text-indigo-400 text-xs rounded-full">
                                Yeni
                            </span>
                        }
                    </div>
                </div>
            </div>

            <!-- Subject -->
            <div class="px-6 py-4 bg-gray-900/30 border-b border-gray-700/50">
                <div class="flex items-center gap-2">
                    <span class="text-gray-500 text-sm">Konu:</span>
                    <span class="text-white font-medium">@Model.Subject</span>
                </div>
            </div>

            <!-- Message Content -->
            <div class="p-6">
                <div class="prose prose-invert max-w-none">
                    <p class="text-gray-300 leading-relaxed whitespace-pre-wrap">@Model.MessageDetail</p>
                </div>
            </div>

            <!-- Actions -->
            <div class="px-6 py-4 bg-gray-900/30 border-t border-gray-700/50">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <a href="mailto:@Model.Email?subject=Re: @Model.Subject"
                           class="inline-flex items-center gap-2 px-4 py-2 bg-indigo-500 hover:bg-indigo-600 text-white font-medium rounded-xl transition-all">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                                <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z" />
                                <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z" />
                            </svg>
                            Yanıtla
                        </a>
                        <a href="/Message/ToggleRead/@Model.MessageId"
                           class="inline-flex items-center gap-2 px-4 py-2 bg-gray-700 hover:bg-gray-600 text-gray-300 font-medium rounded-xl transition-all">
                            @if (Model.IsRead)
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M2.94 6.412A2 2 0 002 8.108V16a2 2 0 002 2h12a2 2 0 002-2V8.108a2 2 0 00-.94-1.696l-6-3.75a2 2 0 00-2.12 0l-6 3.75zm2.615 2.423a1 1 0 10-1.11 1.664l5 3.333a1 1 0 001.11 0l5-3.333a1 1 0 00-1.11-1.664L10 11.798 5.555 8.835z" clip-rule="evenodd" />
                                </svg>
                                <span>Okunmadı İşaretle</span>
                            }
                            else
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                                </svg>
                                <span>Okundu İşaretle</span>
                            }
                        </a>
                    </div>

                    <a href="/Message/DeleteMessage/@Model.MessageId"
                       class="inline-flex items-center gap-2 px-4 py-2 bg-red-500/10 hover:bg-red-500/20 text-red-400 font-medium rounded-xl transition-all"
                       onclick="return confirm('Bu mesajı silmek istediğinizden emin misiniz?')">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
                        </svg>
                        Sil
                    </a>
                </div>
            </div>
        </div>

        <!-- Message Info Card -->
        <div class="mt-6 bg-gray-800/40 backdrop-blur-sm border border-gray-700/50 rounded-xl p-4">
            <div class="flex items-center justify-between text-sm">
                <div class="flex items-center gap-6">
                    <div class="flex items-center gap-2 text-gray-400">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-6-3a2 2 0 11-4 0 2 2 0 014 0zm-2 4a5 5 0 00-4.546 2.916A5.986 5.986 0 0010 16a5.986 5.986 0 004.546-2.084A5 5 0 0010 11z" clip-rule="evenodd" />
                        </svg>
                        Gönderen: <span class="text-white">@Model.NameSurname</span>
                    </div>
                    <div class="flex items-center gap-2 text-gray-400">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                            <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z" />
                            <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z" />
                        </svg>
                        E-posta: <span class="text-white">@Model.Email</span>
                    </div>
                </div>
                <div class="text-gray-500">
                    Mesaj ID: #@Model.MessageId
                </div>
            </div>
        </div>
    </div>
</div>