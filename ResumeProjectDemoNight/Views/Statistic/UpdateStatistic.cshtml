@model ResumeProjectDemoNight.Entities.Statistic
@{
    ViewData["Title"] = "İstatistik Düzenle";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<!-- Font Awesome CDN -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<div class="min-h-screen p-6 lg:p-8">
    <div class="max-w-2xl mx-auto">

        <!-- Header -->
        <div class="mb-8">
            <a href="/Statistic/StatisticList/" class="inline-flex items-center gap-2 text-gray-400 hover:text-white transition-colors mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
                </svg>
                İstatistiklere Dön
            </a>
            <div class="flex items-center gap-3">
                <div class="w-12 h-12 bg-gradient-to-br from-amber-500 to-orange-500 rounded-2xl flex items-center justify-center shadow-lg shadow-amber-500/30">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" viewBox="0 0 20 20" fill="currentColor">
                        <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" />
                    </svg>
                </div>
                <div>
                    <h1 class="text-2xl font-bold text-white">İstatistik Düzenle</h1>
                    <p class="text-gray-400 text-sm">@Model.Name</p>
                </div>
            </div>
        </div>

        <!-- Form Card -->
        <form asp-action="UpdateStatistic" method="post">
            <input type="hidden" asp-for="StatisticId" />

            <div class="bg-gray-800/40 backdrop-blur-sm border border-gray-700/50 rounded-2xl p-6 lg:p-8 space-y-6">

                <!-- Name -->
                <div>
                    <label class="block text-sm font-medium text-gray-300 mb-2">
                        İstatistik Adı <span class="text-red-400">*</span>
                    </label>
                    <input type="text"
                           asp-for="Name"
                           id="nameInput"
                           placeholder="Örn: Tamamlanan Proje"
                           class="w-full bg-gray-900/50 border border-gray-600 rounded-xl px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-rose-500 focus:ring-1 focus:ring-rose-500 transition-all"
                           required>
                </div>

                <!-- Value & Suffix Row -->
                <div class="grid grid-cols-2 gap-4">
                    <!-- Value -->
                    <div>
                        <label class="block text-sm font-medium text-gray-300 mb-2">
                            Değer <span class="text-red-400">*</span>
                        </label>
                        <input type="number"
                               asp-for="Value"
                               id="valueInput"
                               step="0.01"
                               placeholder="100"
                               class="w-full bg-gray-900/50 border border-gray-600 rounded-xl px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-rose-500 focus:ring-1 focus:ring-rose-500 transition-all"
                               required>
                    </div>

                    <!-- Suffix -->
                    <div>
                        <label class="block text-sm font-medium text-gray-300 mb-2">
                            Sonek
                        </label>
                        <input type="text"
                               asp-for="Suffix"
                               id="suffixInput"
                               placeholder="+ veya K, M, B+"
                               class="w-full bg-gray-900/50 border border-gray-600 rounded-xl px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-rose-500 focus:ring-1 focus:ring-rose-500 transition-all">
                        <p class="text-gray-500 text-xs mt-1">Örn: +, K, M, B+, %</p>
                    </div>
                </div>

                <!-- Icon URL -->
                <div>
                    <label class="block text-sm font-medium text-gray-300 mb-2">
                        İkon Sınıfı <span class="text-red-400">*</span>
                    </label>
                    <input type="text"
                           asp-for="IconUrl"
                           id="iconInput"
                           placeholder="fas fa-fire"
                           class="w-full bg-gray-900/50 border border-gray-600 rounded-xl px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-rose-500 focus:ring-1 focus:ring-rose-500 transition-all"
                           required>

                    <!-- Quick Icon Selection -->
                    <div class="mt-3">
                        <p class="text-gray-500 text-xs mb-2">Hızlı seçim:</p>
                        <div class="flex flex-wrap gap-2">
                            <button type="button" onclick="setIcon('fas fa-fire')" class="p-3 bg-gray-700/50 hover:bg-rose-500/20 rounded-lg transition-all group" title="Fire">
                                <i class="fas fa-fire text-gray-400 group-hover:text-rose-400"></i>
                            </button>
                            <button type="button" onclick="setIcon('fas fa-laptop-code')" class="p-3 bg-gray-700/50 hover:bg-rose-500/20 rounded-lg transition-all group" title="Laptop">
                                <i class="fas fa-laptop-code text-gray-400 group-hover:text-rose-400"></i>
                            </button>
                            <button type="button" onclick="setIcon('fas fa-globe')" class="p-3 bg-gray-700/50 hover:bg-rose-500/20 rounded-lg transition-all group" title="Globe">
                                <i class="fas fa-globe text-gray-400 group-hover:text-rose-400"></i>
                            </button>
                            <button type="button" onclick="setIcon('fas fa-award')" class="p-3 bg-gray-700/50 hover:bg-rose-500/20 rounded-lg transition-all group" title="Award">
                                <i class="fas fa-award text-gray-400 group-hover:text-rose-400"></i>
                            </button>
                            <button type="button" onclick="setIcon('fas fa-users')" class="p-3 bg-gray-700/50 hover:bg-rose-500/20 rounded-lg transition-all group" title="Users">
                                <i class="fas fa-users text-gray-400 group-hover:text-rose-400"></i>
                            </button>
                            <button type="button" onclick="setIcon('fas fa-code')" class="p-3 bg-gray-700/50 hover:bg-rose-500/20 rounded-lg transition-all group" title="Code">
                                <i class="fas fa-code text-gray-400 group-hover:text-rose-400"></i>
                            </button>
                            <button type="button" onclick="setIcon('fas fa-coffee')" class="p-3 bg-gray-700/50 hover:bg-rose-500/20 rounded-lg transition-all group" title="Coffee">
                                <i class="fas fa-coffee text-gray-400 group-hover:text-rose-400"></i>
                            </button>
                            <button type="button" onclick="setIcon('fas fa-star')" class="p-3 bg-gray-700/50 hover:bg-rose-500/20 rounded-lg transition-all group" title="Star">
                                <i class="fas fa-star text-gray-400 group-hover:text-rose-400"></i>
                            </button>
                            <button type="button" onclick="setIcon('fas fa-heart')" class="p-3 bg-gray-700/50 hover:bg-rose-500/20 rounded-lg transition-all group" title="Heart">
                                <i class="fas fa-heart text-gray-400 group-hover:text-rose-400"></i>
                            </button>
                            <button type="button" onclick="setIcon('fas fa-rocket')" class="p-3 bg-gray-700/50 hover:bg-rose-500/20 rounded-lg transition-all group" title="Rocket">
                                <i class="fas fa-rocket text-gray-400 group-hover:text-rose-400"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Preview -->
                <div class="pt-4 border-t border-gray-700/50">
                    <label class="block text-sm font-medium text-gray-300 mb-3">Önizleme</label>
                    <div class="bg-gray-900/50 rounded-xl p-6 border border-gray-700/50">
                        <div class="flex items-center gap-4">
                            <div class="w-14 h-14 bg-gradient-to-br from-rose-500/20 to-pink-500/20 rounded-2xl flex items-center justify-center border border-rose-500/30">
                                <i id="previewIcon" class="@Model.IconUrl text-2xl text-rose-400"></i>
                            </div>
                            <div>
                                <div class="flex items-baseline gap-1">
                                    <span id="previewValue" class="text-3xl font-bold text-white">@Model.Value</span>
                                    <span id="previewSuffix" class="text-xl font-bold text-rose-400">@Model.Suffix</span>
                                </div>
                                <p id="previewName" class="text-gray-400">@Model.Name</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Buttons -->
                <div class="flex gap-4 pt-4">
                    <button type="submit"
                            class="flex-1 inline-flex items-center justify-center gap-2 bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-600 hover:to-orange-600 text-white font-semibold px-6 py-3.5 rounded-xl transition-all duration-300 shadow-lg shadow-amber-500/25">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                            <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" />
                        </svg>
                        Değişiklikleri Kaydet
                    </button>
                    <a href="/Statistic/StatisticList/"
                       class="px-6 py-3.5 bg-gray-700 hover:bg-gray-600 text-gray-300 font-medium rounded-xl transition-all">
                        İptal
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

<script>
    const nameInput = document.getElementById('nameInput');
    const valueInput = document.getElementById('valueInput');
    const suffixInput = document.getElementById('suffixInput');
    const iconInput = document.getElementById('iconInput');

    const previewName = document.getElementById('previewName');
    const previewValue = document.getElementById('previewValue');
    const previewSuffix = document.getElementById('previewSuffix');
    const previewIcon = document.getElementById('previewIcon');

    nameInput?.addEventListener('input', function() {
        previewName.textContent = this.value || 'İstatistik Adı';
    });

    valueInput?.addEventListener('input', function() {
        previewValue.textContent = this.value || '0';
    });

    suffixInput?.addEventListener('input', function() {
        previewSuffix.textContent = this.value || '+';
    });

    iconInput?.addEventListener('input', function() {
        previewIcon.className = this.value + ' text-2xl text-rose-400';
    });

    function setIcon(iconClass) {
        iconInput.value = iconClass;
        previewIcon.className = iconClass + ' text-2xl text-rose-400';
    }
</script>