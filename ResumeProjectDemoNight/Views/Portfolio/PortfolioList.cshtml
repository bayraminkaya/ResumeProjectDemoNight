@model List<ResumeProjectDemoNight.Entities.Portfolio>
@{
    ViewData["Title"] = "Portfolyo";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    var categories = ViewBag.Categories as List<ResumeProjectDemoNight.Entities.Category> ?? new List<ResumeProjectDemoNight.Entities.Category>();
}

<div class="min-h-screen p-6 lg:p-8">
    <div class="max-w-7xl mx-auto">

        <!-- Header Section -->
        <div class="relative mb-10">
            <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6">
                <div>
                    <div class="flex items-center gap-3 mb-3">
                        <div class="w-12 h-12 bg-gradient-to-br from-cyan-500 to-blue-600 rounded-2xl flex items-center justify-center shadow-lg shadow-cyan-500/30">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z" />
                            </svg>
                        </div>
                        <div>
                            <h1 class="text-3xl font-bold text-white">Portfolyo</h1>
                            <p class="text-gray-400 mt-1">Projelerinizi yönetin ve sergileyin</p>
                        </div>
                    </div>
                </div>

                <div class="flex items-center gap-3">
                    <!-- Kategori Yönetimi Butonu -->
                    <button type="button"
                            onclick="toggleCategoryPanel()"
                            class="inline-flex items-center gap-2 bg-gray-700 hover:bg-gray-600 text-white font-medium px-4 py-3 rounded-xl transition-all">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                            <path d="M7 3a1 1 0 000 2h6a1 1 0 100-2H7zM4 7a1 1 0 011-1h10a1 1 0 110 2H5a1 1 0 01-1-1zM2 11a2 2 0 012-2h12a2 2 0 012 2v4a2 2 0 01-2 2H4a2 2 0 01-2-2v-4z" />
                        </svg>
                        Kategoriler
                        <span class="px-2 py-0.5 bg-gray-600 rounded-full text-xs">@categories.Count</span>
                    </button>

                    <a href="/Portfolio/CreatePortfolio/"
                       class="group relative inline-flex items-center gap-2 bg-gradient-to-r from-cyan-500 to-blue-600 text-white font-semibold px-6 py-3 rounded-xl transition-all duration-300 shadow-lg shadow-cyan-500/25 hover:shadow-xl hover:shadow-cyan-500/40 hover:-translate-y-0.5 overflow-hidden">
                        <span class="absolute inset-0 bg-gradient-to-r from-cyan-400 to-blue-500 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></span>
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 relative z-10" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
                        </svg>
                        <span class="relative z-10">Yeni Proje Ekle</span>
                    </a>
                </div>
            </div>

            <div class="absolute -top-4 -right-4 w-24 h-24 bg-cyan-500/10 rounded-full blur-2xl"></div>
            <div class="absolute -bottom-4 -left-4 w-32 h-32 bg-blue-500/10 rounded-full blur-2xl"></div>
        </div>

        <!-- Category Management Panel (Hidden by default) -->
        <div id="categoryPanel" class="hidden mb-8">
            <div class="bg-gray-800/60 backdrop-blur-sm border border-gray-700/50 rounded-2xl p-6">
                <div class="flex items-center justify-between mb-6">
                    <h3 class="text-lg font-semibold text-white flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-cyan-400" viewBox="0 0 20 20" fill="currentColor">
                            <path d="M7 3a1 1 0 000 2h6a1 1 0 100-2H7zM4 7a1 1 0 011-1h10a1 1 0 110 2H5a1 1 0 01-1-1zM2 11a2 2 0 012-2h12a2 2 0 012 2v4a2 2 0 01-2 2H4a2 2 0 01-2-2v-4z" />
                        </svg>
                        Kategori Yönetimi
                    </h3>
                    <button type="button" onclick="toggleCategoryPanel()" class="text-gray-400 hover:text-white transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
                        </svg>
                    </button>
                </div>

                <!-- Add New Category -->
                <form action="/Portfolio/CreateCategory" method="post" class="mb-6">
                    <div class="flex gap-3">
                        <input type="text"
                               name="categoryName"
                               placeholder="Yeni kategori adı..."
                               class="flex-1 bg-gray-900/50 border border-gray-600 rounded-xl px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-cyan-500 transition-all"
                               required>
                        <button type="submit"
                                class="inline-flex items-center gap-2 bg-cyan-500 hover:bg-cyan-600 text-white font-medium px-5 py-3 rounded-xl transition-all">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
                            </svg>
                            Ekle
                        </button>
                    </div>
                </form>

                <!-- Category List -->
                @if (categories.Any())
                {
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                        @foreach (var category in categories)
                        {
                            var projectCount = Model.Count(p => p.CategoryId == category.CategoryId);

                            <div class="group bg-gray-900/50 border border-gray-700/50 rounded-xl p-4 hover:border-cyan-500/40 transition-all" id="category-@category.CategoryId">
                                <!-- View Mode -->
                                <div class="category-view-mode">
                                    <div class="flex items-center justify-between">
                                        <div class="flex items-center gap-3">
                                            <div class="w-10 h-10 bg-gradient-to-br from-cyan-500/20 to-blue-500/20 rounded-lg flex items-center justify-center border border-cyan-500/30">
                                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-cyan-400" viewBox="0 0 20 20" fill="currentColor">
                                                    <path d="M2 6a2 2 0 012-2h5l2 2h5a2 2 0 012 2v6a2 2 0 01-2 2H4a2 2 0 01-2-2V6z" />
                                                </svg>
                                            </div>
                                            <div>
                                                <h4 class="text-white font-medium">@category.CategoryName</h4>
                                                <p class="text-gray-500 text-xs">@projectCount proje</p>
                                            </div>
                                        </div>
                                        <div class="flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
                                            <button type="button"
                                                    onclick="editCategory(@category.CategoryId, '@category.CategoryName.Replace("'", "\\'")')"
                                                    class="w-8 h-8 rounded-lg bg-amber-500/10 text-amber-400 hover:bg-amber-500/20 flex items-center justify-center transition-all"
                                                    title="Düzenle">
                                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                                                    <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" />
                                                </svg>
                                            </button>
                                            @if (projectCount == 0)
                                            {
                                                <a href="/Portfolio/DeleteCategory/@category.CategoryId"
                                                   class="w-8 h-8 rounded-lg bg-red-500/10 text-red-400 hover:bg-red-500/20 flex items-center justify-center transition-all"
                                                   title="Sil"
                                                   onclick="return confirm('Bu kategoriyi silmek istediğinizden emin misiniz?')">
                                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                                                        <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
                                                    </svg>
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="w-8 h-8 rounded-lg bg-gray-700/50 text-gray-500 flex items-center justify-center cursor-not-allowed" title="Projeler var, silinemez">
                                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                                                        <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd" />
                                                    </svg>
                                                </span>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <!-- Edit Mode (Hidden by default) -->
                                <form action="/Portfolio/UpdateCategory" method="post" class="category-edit-mode hidden">
                                    <input type="hidden" name="categoryId" value="@category.CategoryId">
                                    <div class="flex gap-2">
                                        <input type="text"
                                               name="categoryName"
                                               value="@category.CategoryName"
                                               class="flex-1 bg-gray-800 border border-cyan-500 rounded-lg px-3 py-2 text-white text-sm focus:outline-none"
                                               required>
                                        <button type="submit" class="px-3 py-2 bg-cyan-500 hover:bg-cyan-600 text-white rounded-lg transition-all">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                                                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                                            </svg>
                                        </button>
                                        <button type="button" onclick="cancelEdit(@category.CategoryId)" class="px-3 py-2 bg-gray-600 hover:bg-gray-500 text-white rounded-lg transition-all">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                                                <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
                                            </svg>
                                        </button>
                                    </div>
                                </form>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-8">
                        <div class="w-16 h-16 bg-gray-800 rounded-xl flex items-center justify-center mx-auto mb-4 border border-gray-700">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
                            </svg>
                        </div>
                        <p class="text-gray-500">Henüz kategori eklenmemiş.</p>
                        <p class="text-gray-600 text-sm mt-1">Yukarıdaki formdan yeni kategori ekleyebilirsiniz.</p>
                    </div>
                }
            </div>
        </div>

        <!-- Stats Cards -->
        @if (Model.Any())
        {
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
                <div class="bg-gray-800/40 backdrop-blur-sm border border-gray-700/50 rounded-xl p-4">
                    <p class="text-gray-400 text-sm">Toplam Proje</p>
                    <p class="text-2xl font-bold text-white mt-1">@Model.Count</p>
                </div>
                <div class="bg-gray-800/40 backdrop-blur-sm border border-gray-700/50 rounded-xl p-4">
                    <p class="text-gray-400 text-sm">Aktif</p>
                    <p class="text-2xl font-bold text-emerald-400 mt-1">@Model.Count(x => x.Status)</p>
                </div>
                <div class="bg-gray-800/40 backdrop-blur-sm border border-gray-700/50 rounded-xl p-4">
                    <p class="text-gray-400 text-sm">Pasif</p>
                    <p class="text-2xl font-bold text-gray-500 mt-1">@Model.Count(x => !x.Status)</p>
                </div>
                <div class="bg-gray-800/40 backdrop-blur-sm border border-gray-700/50 rounded-xl p-4">
                    <p class="text-gray-400 text-sm">GitHub Bağlantılı</p>
                    <p class="text-2xl font-bold text-violet-400 mt-1">@Model.Count(x => !string.IsNullOrEmpty(x.GithubUrl))</p>
                </div>
            </div>
        }

        <!-- Success/Error Messages -->
        @if (TempData["Success"] != null)
        {
            <div class="mb-6 bg-green-500/10 border border-green-500/50 rounded-xl p-4 flex items-center gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-green-400 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                <span class="text-green-400">@TempData["Success"]</span>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="mb-6 bg-red-500/10 border border-red-500/50 rounded-xl p-4 flex items-center gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-red-400 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                </svg>
                <span class="text-red-400">@TempData["Error"]</span>
            </div>
        }

        <!-- Portfolio Grid -->
        @if (Model.Any())
        {
            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
                @foreach (var item in Model)
                {
                    <div class="group relative bg-gray-800/40 backdrop-blur-sm border border-gray-700/50 rounded-2xl overflow-hidden hover:border-cyan-500/40 transition-all duration-500 hover:shadow-2xl hover:shadow-cyan-500/10 hover:-translate-y-1">

                        <!-- Image Section -->
                        <div class="relative h-52 bg-gradient-to-br from-gray-700/50 to-gray-800/50 overflow-hidden">
                            <img src="@item.ImageUrl"
                                 alt="@item.ProjectTitle"
                                 class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
                                 onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                            <div class="w-full h-full items-center justify-center hidden absolute inset-0 bg-gradient-to-br from-cyan-500/20 to-blue-500/20">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                </svg>
                            </div>

                            <!-- Gradient Overlay -->
                            <div class="absolute inset-0 bg-gradient-to-t from-gray-900 via-gray-900/40 to-transparent"></div>

                            <!-- Status Badge -->
                            @if (item.Status)
                            {
                                <div class="absolute top-3 left-3 px-3 py-1 bg-emerald-500/90 backdrop-blur-sm rounded-full flex items-center gap-1.5">
                                    <span class="w-1.5 h-1.5 bg-white rounded-full animate-pulse"></span>
                                    <span class="text-white text-xs font-semibold">Aktif</span>
                                </div>
                            }
                            else
                            {
                                <div class="absolute top-3 left-3 px-3 py-1 bg-gray-600/90 backdrop-blur-sm rounded-full">
                                    <span class="text-gray-300 text-xs font-semibold">Pasif</span>
                                </div>
                            }

                            <!-- GitHub Link -->
                            @if (!string.IsNullOrEmpty(item.GithubUrl))
                            {
                                <a href="@item.GithubUrl" target="_blank"
                                   class="absolute top-3 right-3 w-9 h-9 bg-black/50 backdrop-blur-sm rounded-lg flex items-center justify-center text-white hover:bg-gray-700 transition-colors border border-white/10">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                                        <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                                    </svg>
                                </a>
                            }

                            <!-- Category Badge -->
                            @if (item.Category != null)
                            {
                                <div class="absolute bottom-12 left-4">
                                    <span class="px-2 py-1 bg-cyan-500/80 backdrop-blur-sm text-white text-xs font-medium rounded-lg">
                                        @item.Category.CategoryName
                                    </span>
                                </div>
                            }

                            <!-- Project Title on Image -->
                            <div class="absolute bottom-0 left-0 right-0 p-4">
                                <h3 class="text-xl font-bold text-white group-hover:text-cyan-400 transition-colors line-clamp-1">
                                    @item.ProjectTitle
                                </h3>
                            </div>
                        </div>

                        <!-- Content Section -->
                        <div class="p-5">
                            <!-- Description -->
                            @if (!string.IsNullOrEmpty(item.Description))
                            {
                                <p class="text-gray-400 text-sm leading-relaxed line-clamp-2 mb-4">
                                    @item.Description
                                </p>
                            }

                            <!-- Tech Stack -->
                            @if (!string.IsNullOrEmpty(item.TechStack))
                            {
                                <div class="flex flex-wrap gap-2 mb-4">
                                    @foreach (var tech in item.TechStack.Split(',').Take(4))
                                    {
                                        <span class="px-2.5 py-1 bg-cyan-500/10 text-cyan-400 text-xs font-medium rounded-lg border border-cyan-500/20">
                                            @tech.Trim()
                                        </span>
                                    }
                                    @if (item.TechStack.Split(',').Length > 4)
                                    {
                                        <span class="px-2.5 py-1 bg-gray-700/50 text-gray-400 text-xs font-medium rounded-lg">
                                            +@(item.TechStack.Split(',').Length - 4)
                                        </span>
                                    }
                                </div>
                            }

                            <!-- Actions -->
                            <div class="flex items-center justify-between pt-4 border-t border-gray-700/50">
                                <span class="text-gray-500 text-xs">ID: @item.PortfolioId</span>
                                <div class="flex items-center gap-2">
                                    <a href="/Portfolio/UpdatePortfolio/@item.PortfolioId"
                                       class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-amber-500/10 text-amber-400 hover:bg-amber-500/20 transition-all text-sm font-medium">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                                            <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" />
                                        </svg>
                                        Düzenle
                                    </a>
                                    <a href="/Portfolio/DeletePortfolio/@item.PortfolioId"
                                       class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-red-500/10 text-red-400 hover:bg-red-500/20 transition-all text-sm font-medium"
                                       onclick="return confirm('Bu projeyi silmek istediğinizden emin misiniz?')">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                                            <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
                                        </svg>
                                        Sil
                                    </a>
                                </div>
                            </div>
                        </div>

                        <!-- Bottom Accent Line -->
                        <div class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-cyan-500 to-blue-500 transform scale-x-0 group-hover:scale-x-100 transition-transform duration-500 origin-left"></div>
                    </div>
                }
            </div>
        }

        <!-- Empty State -->
        @if (!Model.Any())
        {
            <div class="relative bg-gray-800/40 backdrop-blur-sm border border-gray-700/50 border-dashed rounded-2xl p-12 text-center">
