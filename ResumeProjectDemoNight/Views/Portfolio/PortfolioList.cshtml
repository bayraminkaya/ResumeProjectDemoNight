            </div>
        }

        <!-- Footer Stats -->
        @if (Model.Any())
        {
            <div class="mt-8 flex items-center justify-center">
                <div class="inline-flex items-center gap-4 px-6 py-3 bg-gray-800/40 backdrop-blur-sm rounded-full border border-gray-700/50">
                    <div class="flex items-center gap-2">
                        <span class="relative flex h-2 w-2">
                            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"></span>
                            <span class="relative inline-flex rounded-full h-2 w-2 bg-cyan-500"></span>
                        </span>
                        <span class="text-gray-400 text-sm">Portfolyo</span>
                    </div>
                    <div class="w-px h-4 bg-gray-700"></div>
                    <span class="text-gray-300 text-sm font-medium">
                        <span class="text-cyan-400">@Model.Count</span> proje listeleniyor
                    </span>
                </div>
            </div>
        }
    </div>
</div>

<!-- Category Panel JavaScript -->
<script>
    function toggleCategoryPanel() {
        const panel = document.getElementById('categoryPanel');
        panel.classList.toggle('hidden');
    }

    function editCategory(id, name) {
        const container = document.getElementById('category-' + id);
        container.querySelector('.category-view-mode').classList.add('hidden');
        container.querySelector('.category-edit-mode').classList.remove('hidden');
        container.querySelector('.category-edit-mode input[name="categoryName"]').focus();
    }

    function cancelEdit(id) {
        const container = document.getElementById('category-' + id);
        container.querySelector('.category-view-mode').classList.remove('hidden');
        container.querySelector('.category-edit-mode').classList.add('hidden');
    }
</script>