@model ResumeProjectDemoNight.Entities.Portfolio
@{
    ViewData["Title"] = "Proje Düzenle";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="min-h-screen p-6 lg:p-8">
    <div class="max-w-5xl mx-auto">

        <!-- Header -->
        <div class="mb-8">
            <a href="/Portfolio/PortfolioList/" class="inline-flex items-center gap-2 text-gray-400 hover:text-white transition-colors mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
                </svg>
                Portfolyoya Dön
            </a>
            <div class="flex items-center gap-3">
                <div class="w-12 h-12 bg-gradient-to-br from-amber-500 to-orange-500 rounded-2xl flex items-center justify-center shadow-lg shadow-amber-500/30">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" viewBox="0 0 20 20" fill="currentColor">
                        <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" />
                    </svg>
                </div>
                <div>
                    <h1 class="text-2xl font-bold text-white">Proje Düzenle</h1>
                    <p class="text-gray-400 text-sm">@Model.ProjectTitle</p>
                </div>
            </div>
        </div>

        <!-- Form -->
        <form asp-action="UpdatePortfolio" method="post">
            <input type="hidden" asp-for="PortfolioId" />

            <div class="grid grid-cols-1 lg:grid-cols-5 gap-6">

                <!-- Left Column - Form Fields -->
                <div class="lg:col-span-3 space-y-6">
                    <div class="bg-gray-800/40 backdrop-blur-sm border border-gray-700/50 rounded-2xl p-6 space-y-5">
                        <h2 class="text-lg font-semibold text-white flex items-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-cyan-400" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h8a2 2 0 012 2v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4zm3 1h6v4H7V5zm6 6H7v2h6v-2z" clip-rule="evenodd" />
                            </svg>
                            Proje Bilgileri
                        </h2>

                        <!-- Project Title -->
                        <div>
                            <label class="block text-sm font-medium text-gray-300 mb-2">
                                Proje Başlığı <span class="text-red-400">*</span>
                            </label>
                            <input type="text"
                                   asp-for="ProjectTitle"
                                   id="titleInput"
                                   placeholder="Örn: E-Ticaret Platformu"
                                   class="w-full bg-gray-900/50 border border-gray-600 rounded-xl px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 transition-all"
                                   required>
                        </div>

                        <!-- Description -->
                        <div>
                            <label class="block text-sm font-medium text-gray-300 mb-2">
                                Açıklama
                            </label>
                            <textarea asp-for="Description"
                                      id="descInput"
                                      rows="3"
                                      placeholder="Proje hakkında kısa bir açıklama..."
                                      class="w-full bg-gray-900/50 border border-gray-600 rounded-xl px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 transition-all resize-none"></textarea>
                        </div>

                        <!-- Category ID -->
                        <div>
                            <label class="block text-sm font-medium text-gray-300 mb-2">
                                Kategori <span class="text-red-400">*</span>
                            </label>
                            <select asp-for="CategoryId"
                                    id="categoryInput"
                                    class="w-full bg-gray-900/50 border border-gray-600 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 transition-all"
                                    required>
                                @if (ViewBag.Categories != null)
                                {
                                    foreach (var category in ViewBag.Categories as List<ResumeProjectDemoNight.Entities.Category>)
                                    {
                                        if (Model.CategoryId == category.CategoryId)
                                        {
                                            <option value="@category.CategoryId" selected>@category.CategoryName</option>
                                        }
                                        else
                                        {
                                            <option value="@category.CategoryId">@category.CategoryName</option>
                                        }
                                    }
                                }
                            </select>
                        </div>

                        <!-- Tech Stack -->
                        <div>
                            <label class="block text-sm font-medium text-gray-300 mb-2">
                                Teknolojiler
                            </label>
                            <input type="text"
                                   asp-for="TechStack"
                                   id="techInput"
                                   placeholder="Örn: ASP.NET Core, C#, SQL Server, React"
                                   class="w-full bg-gray-900/50 border border-gray-600 rounded-xl px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 transition-all">
                            <p class="text-gray-500 text-xs mt-2">Virgülle ayırarak yazın</p>
                        </div>

                        <!-- Status -->
                        <div>
                            <label class="block text-sm font-medium text-gray-300 mb-2">
                                Durum
                            </label>
                            <div class="flex items-center gap-4">
                                <label class="relative inline-flex items-center cursor-pointer">
                                    <input type="checkbox" asp-for="Status" id="statusInput" class="sr-only peer">
                                    <div class="w-14 h-7 bg-gray-700 peer-focus:outline-none peer-focus:ring-2 peer-focus:ring-cyan-500/50 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-0.5 after:left-[4px] after:bg-white after:rounded-full after:h-6 after:w-6 after:transition-all peer-checked:bg-emerald-500"></div>
                                </label>
                                <span id="statusText" class="text-sm text-gray-400">
                                    @(Model.Status ? "Aktif" : "Pasif")
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- Images & Links -->
                    <div class="bg-gray-800/40 backdrop-blur-sm border border-gray-700/50 rounded-2xl p-6 space-y-5">
                        <h2 class="text-lg font-semibold text-white flex items-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-cyan-400" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z" clip-rule="evenodd" />
                            </svg>
                            Görseller & Bağlantılar
                        </h2>

                        <!-- Image URL -->
                        <div>
                            <label class="block text-sm font-medium text-gray-300 mb-2">
                                Ana Görsel URL'si <span class="text-red-400">*</span>
                            </label>
                            <input type="url"
                                   asp-for="ImageUrl"
                                   id="imageInput"
                                   placeholder="https://example.com/project-image.jpg"
                                   class="w-full bg-gray-900/50 border border-gray-600 rounded-xl px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 transition-all"
                                   required>
                        </div>

                        <!-- Other Images - Dynamic List -->
                        <div>
                            <label class="block text-sm font-medium text-gray-300 mb-2">
                                Diğer Görseller
                            </label>

                            <!-- Hidden input for form submission -->
                            <input type="hidden" asp-for="OtherImages" id="otherImagesHidden" />

                            <!-- Dynamic Image List -->
                            <div id="imageListContainer" class="space-y-3">
                                <!-- Images will be added here dynamically -->
                            </div>

                            <!-- Add Button -->
                            <button type="button"
                                    onclick="addImageInput()"
                                    class="mt-3 w-full inline-flex items-center justify-center gap-2 px-4 py-3 bg-gray-700/50 hover:bg-gray-600/50 border border-gray-600 border-dashed rounded-xl text-gray-400 hover:text-white transition-all">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
                                </svg>
                                Görsel Ekle
                            </button>

                            <p class="text-gray-500 text-xs mt-2">Her görsel için ayrı satır ekleyin</p>
                        </div>

                        <!-- GitHub URL -->
                        <div>
                            <label class="block text-sm font-medium text-gray-300 mb-2">
                                GitHub URL'si
                            </label>
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-500" fill="currentColor" viewBox="0 0 24 24">
                                        <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                                    </svg>
                                </div>
                                <input type="url"
                                       asp-for="GithubUrl"
                                       id="githubInput"
                                       placeholder="https://github.com/username/repo"
                                       class="w-full bg-gray-900/50 border border-gray-600 rounded-xl pl-12 pr-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 transition-all">
                            </div>
                        </div>
                    </div>

                    <!-- Buttons -->
                    <div class="flex gap-4">
                        <button type="submit"
                                class="flex-1 inline-flex items-center justify-center gap-2 bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-600 hover:to-orange-600 text-white font-semibold px-6 py-3.5 rounded-xl transition-all duration-300 shadow-lg shadow-amber-500/25">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                                <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" />
                            </svg>
                            Değişiklikleri Kaydet
                        </button>
                        <a href="/Portfolio/PortfolioList/"
                           class="px-6 py-3.5 bg-gray-700 hover:bg-gray-600 text-gray-300 font-medium rounded-xl transition-all">
                            İptal
                        </a>
                    </div>
                </div>

                <!-- Right Column - Preview -->
                <div class="lg:col-span-2">
                    <div class="sticky top-6">
                        <h3 class="text-sm font-medium text-gray-400 mb-3 flex items-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                                <path d="M10 12a2 2 0 100-4 2 2 0 000 4z" />
                                <path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd" />
                            </svg>
                            Canlı Önizleme
                        </h3>

                        <div class="bg-gray-800/40 backdrop-blur-sm border border-gray-700/50 rounded-2xl overflow-hidden">
                            <!-- Preview Image -->
                            <div class="relative h-48 bg-gradient-to-br from-gray-700/50 to-gray-800/50">
                                <img id="previewImage"
                                     src="@Model.ImageUrl"
                                     alt="Preview"
                                     class="w-full h-full object-cover">
                                <div id="previewPlaceholder" class="w-full h-full items-center justify-center hidden absolute inset-0">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                    </svg>
                                </div>
                                <div class="absolute inset-0 bg-gradient-to-t from-gray-900 via-gray-900/40 to-transparent"></div>

                                <!-- Status Badge -->
                                <div id="previewStatusBadge" class="absolute top-3 left-3 px-3 py-1 backdrop-blur-sm rounded-full flex items-center gap-1.5 @(Model.Status ? "bg-emerald-500/90" : "bg-gray-600/90")">
                                    @if (Model.Status)
                                    {
                                        <span class="w-1.5 h-1.5 bg-white rounded-full"></span>
                                    }
                                    <span id="previewStatusText" class="text-white text-xs font-semibold">@(Model.Status ? "Aktif" : "Pasif")</span>
                                </div>

                                <!-- GitHub Icon -->
                                @if (!string.IsNullOrEmpty(Model.GithubUrl))
                                {
                                    <div id="previewGithub" class="absolute top-3 right-3 w-9 h-9 bg-black/50 backdrop-blur-sm rounded-lg flex items-center justify-center text-white border border-white/10">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                                            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                                        </svg>
                                    </div>
                                }
                                else
                                {
                                    <div id="previewGithub" class="absolute top-3 right-3 w-9 h-9 bg-black/50 backdrop-blur-sm rounded-lg items-center justify-center text-white border border-white/10 hidden">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                                            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                                        </svg>
                                    </div>
                                }

                                <!-- Title -->
                                <div class="absolute bottom-0 left-0 right-0 p-4">
                                    <h3 id="previewTitle" class="text-xl font-bold text-white">@Model.ProjectTitle</h3>
                                </div>
                            </div>

                            <!-- Preview Content -->
                            <div class="p-4">
                                <p id="previewDesc" class="text-gray-400 text-sm leading-relaxed mb-4 line-clamp-2">@(string.IsNullOrEmpty(Model.Description) ? "Proje açıklaması burada görünecek..." : Model.Description)</p>

                                <!-- Tech Tags -->
                                <div id="previewTech" class="flex flex-wrap gap-2">
                                    @if (!string.IsNullOrEmpty(Model.TechStack))
                                    {
                                        @foreach (var tech in Model.TechStack.Split(',').Take(4))
                                        {
                                            <span class="px-2.5 py-1 bg-cyan-500/10 text-cyan-400 text-xs font-medium rounded-lg border border-cyan-500/20">
                                                @tech.Trim()
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="px-2.5 py-1 bg-cyan-500/10 text-cyan-400 text-xs font-medium rounded-lg border border-cyan-500/20">
                                            Teknoloji
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

<script>
    const titleInput = document.getElementById('titleInput');
    const descInput = document.getElementById('descInput');
    const imageInput = document.getElementById('imageInput');
    const techInput = document.getElementById('techInput');
    const githubInput = document.getElementById('githubInput');
    const statusInput = document.getElementById('statusInput');

    const previewTitle = document.getElementById('previewTitle');
    const previewDesc = document.getElementById('previewDesc');
    const previewImage = document.getElementById('previewImage');
    const previewPlaceholder = document.getElementById('previewPlaceholder');
    const previewTech = document.getElementById('previewTech');
    const previewGithub = document.getElementById('previewGithub');
    const previewStatusBadge = document.getElementById('previewStatusBadge');
    const previewStatusText = document.getElementById('previewStatusText');
    const statusText = document.getElementById('statusText');

    titleInput?.addEventListener('input', function() {
        previewTitle.textContent = this.value || 'Proje Başlığı';
    });

    descInput?.addEventListener('input', function() {
        previewDesc.textContent = this.value || 'Proje açıklaması burada görünecek...';
    });

    imageInput?.addEventListener('input', function() {
        if (this.value) {
            previewImage.src = this.value;
            previewImage.classList.remove('hidden');
            previewPlaceholder.classList.add('hidden');

            previewImage.onerror = function() {
                previewImage.classList.add('hidden');
                previewPlaceholder.classList.remove('hidden');
                previewPlaceholder.classList.add('flex');
            };
        } else {
            previewImage.classList.add('hidden');
            previewPlaceholder.classList.remove('hidden');
            previewPlaceholder.classList.add('flex');
        }
    });

    techInput?.addEventListener('input', function() {
        const techs = this.value.split(',').filter(t => t.trim());
        if (techs.length > 0) {
            previewTech.innerHTML = techs.slice(0, 4).map(t =>
                `<span class="px-2.5 py-1 bg-cyan-500/10 text-cyan-400 text-xs font-medium rounded-lg border border-cyan-500/20">${t.trim()}</span>`
            ).join('');
            if (techs.length > 4) {
                previewTech.innerHTML += `<span class="px-2.5 py-1 bg-gray-700/50 text-gray-400 text-xs font-medium rounded-lg">+${techs.length - 4}</span>`;
            }
        } else {
            previewTech.innerHTML = '<span class="px-2.5 py-1 bg-cyan-500/10 text-cyan-400 text-xs font-medium rounded-lg border border-cyan-500/20">Teknoloji</span>';
        }
    });

    githubInput?.addEventListener('input', function() {
        if (this.value) {
            previewGithub.classList.remove('hidden');
            previewGithub.classList.add('flex');
        } else {
            previewGithub.classList.add('hidden');
            previewGithub.classList.remove('flex');
        }
    });

    statusInput?.addEventListener('change', function() {
        if (this.checked) {
            previewStatusBadge.classList.remove('bg-gray-600/90');
            previewStatusBadge.classList.add('bg-emerald-500/90');
            previewStatusText.textContent = 'Aktif';
            statusText.textContent = 'Aktif';
        } else {
            previewStatusBadge.classList.remove('bg-emerald-500/90');
            previewStatusBadge.classList.add('bg-gray-600/90');
            previewStatusText.textContent = 'Pasif';
            statusText.textContent = 'Pasif';
        }
    });



    const imageListContainer = document.getElementById('imageListContainer');
    const otherImagesHidden = document.getElementById('otherImagesHidden');
    let imageCounter = 0;

    
    document.addEventListener('DOMContentLoaded', function() {
        const existingImages = otherImagesHidden.value;
        if (existingImages && existingImages.trim()) {
            const images = existingImages.split(',').map(img => img.trim()).filter(img => img);
            images.forEach(url => addImageInput(url));
        }

        
        if (imageListContainer.children.length === 0) {
            
        }
    });

    function addImageInput(existingUrl = '') {
        imageCounter++;
        const itemId = `image-item-${imageCounter}`;

        const itemDiv = document.createElement('div');
        itemDiv.id = itemId;
        itemDiv.className = 'group relative bg-gray-900/30 rounded-xl p-3 border border-gray-700/50';

        itemDiv.innerHTML = `
            <div class="flex items-start gap-3">
                <!-- Preview Thumbnail -->
                <div class="relative flex-shrink-0">
                    <div class="w-16 h-16 rounded-lg bg-gray-800 border border-gray-700 overflow-hidden flex items-center justify-center">
                        <img src="${existingUrl || ''}"
                             class="w-full h-full object-cover ${existingUrl ? '' : 'hidden'}"
                             id="${itemId}-preview"
                             onerror="this.classList.add('hidden'); this.nextElementSibling.classList.remove('hidden');">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-gray-600 ${existingUrl ? 'hidden' : ''}" id="${itemId}-placeholder" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                    </div>
                </div>

                <!-- URL Input -->
                <div class="flex-1">
                    <input type="url"
                           value="${existingUrl}"
                           placeholder="https://example.com/image.jpg"
                           class="image-url-input w-full bg-gray-900/50 border border-gray-600 rounded-lg px-3 py-2 text-white text-sm placeholder-gray-500 focus:outline-none focus:border-cyan-500 transition-all"
                           onchange="updateImagePreview('${itemId}', this.value); updateHiddenInput();"
                           oninput="updateImagePreview('${itemId}', this.value); updateHiddenInput();">
                    <p class="text-gray-600 text-xs mt-1 truncate">${existingUrl ? 'URL girildi' : 'Görsel URL\'si girin'}</p>
                </div>

                <!-- Remove Button -->
                <button type="button"
                        onclick="removeImageInput('${itemId}')"
                        class="flex-shrink-0 w-8 h-8 rounded-lg bg-red-500/10 text-red-400 hover:bg-red-500/20 flex items-center justify-center transition-all"
                        title="Kaldır">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
                    </svg>
                </button>
            </div>
        `;

        imageListContainer.appendChild(itemDiv);
        updateHiddenInput();
    }

    function removeImageInput(itemId) {
        const item = document.getElementById(itemId);
        if (item) {
            item.remove();
            updateHiddenInput();
        }
    }

    function updateImagePreview(itemId, url) {
        const preview = document.getElementById(`${itemId}-preview`);
        const placeholder = document.getElementById(`${itemId}-placeholder`);

        if (url && url.trim()) {
            preview.src = url;
            preview.classList.remove('hidden');
            placeholder.classList.add('hidden');

            preview.onerror = function() {
                preview.classList.add('hidden');
                placeholder.classList.remove('hidden');
            };
        } else {
            preview.classList.add('hidden');
            placeholder.classList.remove('hidden');
        }
    }

    function updateHiddenInput() {
        const inputs = document.querySelectorAll('.image-url-input');
        const urls = [];

        inputs.forEach(input => {
            if (input.value && input.value.trim()) {
                urls.push(input.value.trim());
            }
        });

        otherImagesHidden.value = urls.join(', ');
    }


    document.querySelector('form')?.addEventListener('submit', function() {
        updateHiddenInput();
    });
</script>