@model ResumeProjectDemoNight.Entities.Testimonial
@{
    ViewData["Title"] = "Referans Düzenle";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="min-h-screen p-6 lg:p-8">
    <div class="max-w-2xl mx-auto">

        <!-- Header -->
        <div class="mb-8">
            <a href="/Testimonial/TestimonialList/" class="inline-flex items-center gap-2 text-gray-400 hover:text-white transition-colors mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
                </svg>
                Referanslara Dön
            </a>
            <div class="flex items-center gap-3">
                <div class="w-12 h-12 bg-gradient-to-br from-amber-500 to-orange-500 rounded-2xl flex items-center justify-center shadow-lg shadow-amber-500/30">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" viewBox="0 0 20 20" fill="currentColor">
                        <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" />
                    </svg>
                </div>
                <div>
                    <h1 class="text-2xl font-bold text-white">Referans Düzenle</h1>
                    <p class="text-gray-400 text-sm">@Model.NameSurname</p>
                </div>
            </div>
        </div>

        <!-- Form Card -->
        <form asp-action="UpdateTestimonial" method="post">
            <input type="hidden" asp-for="TestimonialId" />

            <div class="bg-gray-800/40 backdrop-blur-sm border border-gray-700/50 rounded-2xl p-6 lg:p-8 space-y-6">

                <!-- Name Surname -->
                <div>
                    <label class="block text-sm font-medium text-gray-300 mb-2">
                        Ad Soyad <span class="text-red-400">*</span>
                    </label>
                    <input type="text"
                           asp-for="NameSurname"
                           id="nameInput"
                           placeholder="Örn: Ahmet K."
                           class="w-full bg-gray-900/50 border border-gray-600 rounded-xl px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition-all"
                           required>
                </div>

                <!-- Title -->
                <div>
                    <label class="block text-sm font-medium text-gray-300 mb-2">
                        Ünvan / Pozisyon <span class="text-red-400">*</span>
                    </label>
                    <input type="text"
                           asp-for="Title"
                           id="titleInput"
                           placeholder="Örn: CTO / Startup Kurucusu"
                           class="w-full bg-gray-900/50 border border-gray-600 rounded-xl px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition-all"
                           required>
                </div>

                <!-- Comment -->
                <div>
                    <label class="block text-sm font-medium text-gray-300 mb-2">
                        Görüş / Yorum <span class="text-red-400">*</span>
                    </label>
                    <textarea asp-for="Comment"
                              id="commentInput"
                              rows="4"
                              placeholder="Müşterinizin veya iş arkadaşınızın sizin hakkınızdaki görüşü..."
                              class="w-full bg-gray-900/50 border border-gray-600 rounded-xl px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition-all resize-none"
                              required></textarea>
                </div>

                <!-- Image URL -->
                <div>
                    <label class="block text-sm font-medium text-gray-300 mb-2">
                        Profil Resmi URL'si <span class="text-red-400">*</span>
                    </label>
                    <input type="url"
                           asp-for="ImageUrl"
                           id="imageInput"
                           placeholder="https://example.com/photo.jpg"
                           class="w-full bg-gray-900/50 border border-gray-600 rounded-xl px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition-all"
                           required>
                </div>

                <!-- Preview -->
                <div class="pt-4 border-t border-gray-700/50">
                    <label class="block text-sm font-medium text-gray-300 mb-3">Önizleme</label>
                    <div class="bg-gray-900/50 rounded-xl p-6 border border-gray-700/50 relative overflow-hidden">
                        <!-- Quote Icon -->
                        <div class="absolute top-4 right-4 opacity-10">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-emerald-500" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
                            </svg>
                        </div>

                        <p id="previewComment" class="text-gray-300 leading-relaxed mb-4">"@Model.Comment"</p>

                        <div class="flex items-center gap-4">
                            <img id="previewImage"
                                 src="@Model.ImageUrl"
                                 alt="Preview"
                                 class="w-12 h-12 rounded-full object-cover border-2 border-emerald-500/30"
                                 onerror="this.src='https://ui-avatars.com/api/?name=@Model.NameSurname&background=10b981&color=fff'">
                            <div>
                                <h4 id="previewName" class="text-white font-semibold">@Model.NameSurname</h4>
                                <p id="previewTitle" class="text-emerald-400 text-sm">@Model.Title</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Buttons -->
                <div class="flex gap-4 pt-4">
                    <button type="submit"
                            class="flex-1 inline-flex items-center justify-center gap-2 bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-600 hover:to-orange-600 text-white font-semibold px-6 py-3.5 rounded-xl transition-all duration-300 shadow-lg shadow-amber-500/25">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                            <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" />
                        </svg>
                        Değişiklikleri Kaydet
                    </button>
                    <a href="/Testimonial/TestimonialList/"
                       class="px-6 py-3.5 bg-gray-700 hover:bg-gray-600 text-gray-300 font-medium rounded-xl transition-all">
                        İptal
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

<script>
    const nameInput = document.getElementById('nameInput');
    const titleInput = document.getElementById('titleInput');
    const commentInput = document.getElementById('commentInput');
    const imageInput = document.getElementById('imageInput');

    const previewName = document.getElementById('previewName');
    const previewTitle = document.getElementById('previewTitle');
    const previewComment = document.getElementById('previewComment');
    const previewImage = document.getElementById('previewImage');

    nameInput?.addEventListener('input', function() {
        previewName.textContent = this.value || 'Ad Soyad';
    });

    titleInput?.addEventListener('input', function() {
        previewTitle.textContent = this.value || 'Ünvan';
    });

    commentInput?.addEventListener('input', function() {
        previewComment.textContent = '"' + (this.value || 'Görüş burada görünecek...') + '"';
    });

    imageInput?.addEventListener('input', function() {
        if (this.value) {
            previewImage.src = this.value;
            previewImage.onerror = function() {
                previewImage.src = `https://ui-avatars.com/api/?name=${encodeURIComponent(nameInput.value || 'User')}&background=10b981&color=fff`;
            };
        }
    });
</script>