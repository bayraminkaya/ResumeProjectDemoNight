@model ResumeProjectDemoNight.Entities.Service
@{
    ViewData["Title"] = "Hizmet Düzenle";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="min-h-screen p-6 lg:p-8">
    <div class="max-w-2xl mx-auto">

        <!-- Header -->
        <div class="mb-8">
            <a href="/Service/ServiceList/" class="inline-flex items-center gap-2 text-gray-400 hover:text-white transition-colors mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
                </svg>
                Hizmetlere Dön
            </a>
            <div class="flex items-center gap-3">
                <div class="w-12 h-12 bg-gradient-to-br from-amber-500 to-orange-500 rounded-2xl flex items-center justify-center shadow-lg shadow-amber-500/30">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" viewBox="0 0 20 20" fill="currentColor">
                        <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" />
                    </svg>
                </div>
                <div>
                    <h1 class="text-2xl font-bold text-white">Hizmet Düzenle</h1>
                    <p class="text-gray-400 text-sm">@Model.Title</p>
                </div>
            </div>
        </div>

        <!-- Form Card -->
        <form asp-action="UpdateService" method="post">
            <input type="hidden" asp-for="ServiceId" />

            <div class="bg-gray-800/40 backdrop-blur-sm border border-gray-700/50 rounded-2xl p-6 lg:p-8 space-y-6">

                <!-- Title -->
                <div>
                    <label class="block text-sm font-medium text-gray-300 mb-2">
                        Hizmet Başlığı <span class="text-red-400">*</span>
                    </label>
                    <input type="text"
                           asp-for="Title"
                           id="titleInput"
                           placeholder="Örn: 🖥️ Web Uygulaması Geliştirme"
                           class="w-full bg-gray-900/50 border border-gray-600 rounded-xl px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-violet-500 focus:ring-1 focus:ring-violet-500 transition-all"
                           required>
                    <p class="text-gray-500 text-xs mt-2">İpucu: Başına emoji ekleyebilirsiniz (🖥️ ⚙️ 📱 🎨 🔧)</p>
                </div>

                <!-- Description -->
                <div>
                    <label class="block text-sm font-medium text-gray-300 mb-2">
                        Açıklama <span class="text-red-400">*</span>
                    </label>
                    <textarea asp-for="Description"
                              id="descInput"
                              rows="4"
                              placeholder="Bu hizmet hakkında detaylı bilgi yazın..."
                              class="w-full bg-gray-900/50 border border-gray-600 rounded-xl px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-violet-500 focus:ring-1 focus:ring-violet-500 transition-all resize-none"
                              required></textarea>
                </div>

                <!-- Image URL -->
                <div>
                    <label class="block text-sm font-medium text-gray-300 mb-2">
                        Görsel URL'si <span class="text-red-400">*</span>
                    </label>
                    <input type="url"
                           asp-for="ImageUrl"
                           id="imageInput"
                           placeholder="https://example.com/image.jpg"
                           class="w-full bg-gray-900/50 border border-gray-600 rounded-xl px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-violet-500 focus:ring-1 focus:ring-violet-500 transition-all"
                           required>
                </div>

                <!-- Preview -->
                <div class="pt-4 border-t border-gray-700/50">
                    <label class="block text-sm font-medium text-gray-300 mb-3">Önizleme</label>
                    <div class="bg-gray-900/50 rounded-xl overflow-hidden border border-gray-700/50">
                        <!-- Preview Image -->
                        <div class="relative h-40 bg-gradient-to-br from-gray-700/50 to-gray-800/50 flex items-center justify-center p-4">
                            <img id="previewImage"
                                 src="@(Model?.ImageUrl ?? "")"
                                 alt="Önizleme"
                                 class="max-w-full max-h-full object-contain drop-shadow-lg @(string.IsNullOrEmpty(Model?.ImageUrl) ? "hidden" : "")">
                            <div id="previewPlaceholder" class="flex items-center justify-center @(!string.IsNullOrEmpty(Model?.ImageUrl) ? "hidden" : "")">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                </svg>
                            </div>
                        </div>
                        <!-- Preview Content -->
                        <div class="p-4">
                            <h3 id="previewTitle" class="text-white font-bold mb-1">@Model.Title</h3>
                            <p id="previewDesc" class="text-gray-400 text-sm line-clamp-2">@Model.Description</p>
                        </div>
                    </div>
                </div>

                <!-- Buttons -->
                <div class="flex gap-4 pt-4">
                    <button type="submit"
                            class="flex-1 inline-flex items-center justify-center gap-2 bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-600 hover:to-orange-600 text-white font-semibold px-6 py-3.5 rounded-xl transition-all duration-300 shadow-lg shadow-amber-500/25">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                            <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" />
                        </svg>
                        Değişiklikleri Kaydet
                    </button>
                    <a href="/Service/ServiceList/"
                       class="px-6 py-3.5 bg-gray-700 hover:bg-gray-600 text-gray-300 font-medium rounded-xl transition-all">
                        İptal
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

<script>
    const titleInput = document.getElementById('titleInput');
    const descInput = document.getElementById('descInput');
    const imageInput = document.getElementById('imageInput');
    const previewTitle = document.getElementById('previewTitle');
    const previewDesc = document.getElementById('previewDesc');
    const previewImage = document.getElementById('previewImage');
    const previewPlaceholder = document.getElementById('previewPlaceholder');

    titleInput?.addEventListener('input', function() {
        previewTitle.textContent = this.value || 'Hizmet Başlığı';
    });

    descInput?.addEventListener('input', function() {
        previewDesc.textContent = this.value || 'Hizmet açıklaması burada görünecek...';
    });

    imageInput?.addEventListener('input', function() {
        const url = this.value;
        if (url) {
            previewImage.src = url;
            previewImage.classList.remove('hidden');
            previewPlaceholder.classList.add('hidden');

            previewImage.onerror = function() {
                previewImage.classList.add('hidden');
                previewPlaceholder.classList.remove('hidden');
            };
        } else {
            previewImage.classList.add('hidden');
            previewPlaceholder.classList.remove('hidden');
        }
    });
</script>