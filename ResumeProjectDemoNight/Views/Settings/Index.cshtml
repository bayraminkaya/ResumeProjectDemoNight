@{
    ViewData["Title"] = "Ayarlar";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    var admin = ViewBag.Admin as ResumeProjectDemoNight.Entities.Admin;
}

<div class="min-h-screen p-6 lg:p-8">
    <div class="max-w-4xl mx-auto">

        <!-- Header -->
        <div class="mb-8">
            <div class="flex items-center gap-3">
                <div class="w-12 h-12 bg-gradient-to-br from-gray-600 to-gray-700 rounded-2xl flex items-center justify-center shadow-lg">
                    <span class="material-symbols-outlined text-white text-xl">settings</span>
                </div>
                <div>
                    <h1 class="text-2xl font-bold text-white">Ayarlar</h1>
                    <p class="text-gray-400 text-sm">Hesap ve güvenlik ayarlarınızı yönetin</p>
                </div>
            </div>
        </div>

        <!-- Success/Error Messages -->
        @if (TempData["Success"] != null)
        {
            <div class="mb-6 bg-emerald-500/10 border border-emerald-500/30 rounded-xl p-4 flex items-center gap-3">
                <span class="material-symbols-outlined text-emerald-400">check_circle</span>
                <span class="text-emerald-400">@TempData["Success"]</span>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="mb-6 bg-red-500/10 border border-red-500/30 rounded-xl p-4 flex items-center gap-3">
                <span class="material-symbols-outlined text-red-400">error</span>
                <span class="text-red-400">@TempData["Error"]</span>
            </div>
        }

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

            <!-- Profil Bilgileri -->
            <div class="bg-gray-800/50 backdrop-blur-sm border border-gray-700/50 rounded-2xl overflow-hidden">
                <div class="px-6 py-4 border-b border-gray-700/50 flex items-center gap-2">
                    <span class="material-symbols-outlined text-cyan-400">person</span>
                    <h2 class="text-lg font-semibold text-white">Profil Bilgileri</h2>
                </div>
                <form action="/Settings/UpdateProfile" method="post" class="p-6 space-y-5">

                    <!-- Avatar Preview -->
                    <div class="flex items-center gap-4">
                        <div class="relative">
                            <div id="avatarPreview" class="w-20 h-20 rounded-2xl overflow-hidden border-2 border-cyan-500/30 bg-gray-700">
                                @if (!string.IsNullOrEmpty(admin?.ProfileImage))
                                {
                                    <img src="@admin.ProfileImage" alt="Profile" class="w-full h-full object-cover" id="previewImg">
                                }
                                else
                                {
                                    <div class="w-full h-full bg-gradient-to-br from-cyan-500 to-blue-600 flex items-center justify-center" id="previewInitial">
                                        <span class="text-2xl font-bold text-white">@(admin?.FullName?.Substring(0, 1).ToUpper() ?? "A")</span>
                                    </div>
                                }
                            </div>
                        </div>
                        <div>
                            <p class="text-white font-medium">@admin?.FullName</p>
                            <p class="text-gray-500 text-sm">@admin?.Username</p>
                        </div>
                    </div>

                    <!-- Full Name -->
                    <div>
                        <label class="block text-sm font-medium text-gray-300 mb-2">Ad Soyad</label>
                        <input type="text"
                               name="fullName"
                               value="@admin?.FullName"
                               class="w-full bg-gray-900/50 border border-gray-600 rounded-xl px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 transition-all"
                               required>
                    </div>

                    <!-- Email -->
                    <div>
                        <label class="block text-sm font-medium text-gray-300 mb-2">E-posta</label>
                        <input type="email"
                               name="email"
                               value="@admin?.Email"
                               class="w-full bg-gray-900/50 border border-gray-600 rounded-xl px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 transition-all"
                               required>
                    </div>

                    <!-- Profile Image URL -->
                    <div>
                        <label class="block text-sm font-medium text-gray-300 mb-2">Profil Resmi URL</label>
                        <input type="url"
                               name="profileImage"
                               id="profileImageInput"
                               value="@admin?.ProfileImage"
                               placeholder="https://example.com/image.jpg"
                               class="w-full bg-gray-900/50 border border-gray-600 rounded-xl px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 transition-all">
                        <p class="text-gray-500 text-xs mt-1">Boş bırakırsanız baş harf gösterilir</p>
                    </div>

                    <!-- Submit -->
                    <button type="submit"
                            class="w-full bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-600 hover:to-blue-700 text-white font-semibold py-3 px-4 rounded-xl transition-all duration-300 flex items-center justify-center gap-2">
                        <span class="material-symbols-outlined">save</span>
                        Profili Kaydet
                    </button>
                </form>
            </div>

            <!-- Şifre Değiştir -->
            <div class="bg-gray-800/50 backdrop-blur-sm border border-gray-700/50 rounded-2xl overflow-hidden">
                <div class="px-6 py-4 border-b border-gray-700/50 flex items-center gap-2">
                    <span class="material-symbols-outlined text-amber-400">lock</span>
                    <h2 class="text-lg font-semibold text-white">Şifre Değiştir</h2>
                </div>
                <form action="/Settings/ChangePassword" method="post" class="p-6 space-y-5">

                    <!-- Security Icon -->
                    <div class="flex items-center justify-center py-4">
                        <div class="w-20 h-20 bg-amber-500/10 rounded-full flex items-center justify-center border border-amber-500/30">
                            <span class="material-symbols-outlined text-amber-400 text-4xl">shield_lock</span>
                        </div>
                    </div>

                    <!-- Current Password -->
                    <div>
                        <label class="block text-sm font-medium text-gray-300 mb-2">
                            Mevcut Şifre <span class="text-red-400">*</span>
                        </label>
                        <div class="relative">
                            <input type="password"
                                   name="currentPassword"
                                   id="currentPassword"
                                   placeholder="••••••••"
                                   class="w-full bg-gray-900/50 border border-gray-600 rounded-xl px-4 py-3 pr-12 text-white placeholder-gray-500 focus:outline-none focus:border-amber-500 focus:ring-1 focus:ring-amber-500 transition-all"
                                   required>
                            <button type="button" onclick="togglePass('currentPassword', 'eye1')" class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-500 hover:text-gray-300">
                                <span id="eye1" class="material-symbols-outlined">visibility</span>
                            </button>
                        </div>
                    </div>

                    <!-- New Password -->
                    <div>
                        <label class="block text-sm font-medium text-gray-300 mb-2">
                            Yeni Şifre <span class="text-red-400">*</span>
                        </label>
                        <div class="relative">
                            <input type="password"
                                   name="newPassword"
                                   id="newPassword"
                                   placeholder="••••••••"
                                   class="w-full bg-gray-900/50 border border-gray-600 rounded-xl px-4 py-3 pr-12 text-white placeholder-gray-500 focus:outline-none focus:border-amber-500 focus:ring-1 focus:ring-amber-500 transition-all"
                                   required
                                   minlength="6">
                            <button type="button" onclick="togglePass('newPassword', 'eye2')" class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-500 hover:text-gray-300">
                                <span id="eye2" class="material-symbols-outlined">visibility</span>
                            </button>
                        </div>
                        <p class="text-gray-500 text-xs mt-1">En az 6 karakter</p>
                    </div>

                    <!-- Confirm Password -->
                    <div>
                        <label class="block text-sm font-medium text-gray-300 mb-2">
                            Yeni Şifre (Tekrar) <span class="text-red-400">*</span>
                        </label>
                        <div class="relative">
                            <input type="password"
                                   name="confirmPassword"
                                   id="confirmPassword"
                                   placeholder="••••••••"
                                   class="w-full bg-gray-900/50 border border-gray-600 rounded-xl px-4 py-3 pr-12 text-white placeholder-gray-500 focus:outline-none focus:border-amber-500 focus:ring-1 focus:ring-amber-500 transition-all"
                                   required
                                   minlength="6">
                            <button type="button" onclick="togglePass('confirmPassword', 'eye3')" class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-500 hover:text-gray-300">
                                <span id="eye3" class="material-symbols-outlined">visibility</span>
                            </button>
                        </div>
                    </div>

                    <!-- Password Match Indicator -->
                    <div id="passwordMatch" class="hidden items-center gap-2 text-sm">
                        <span class="material-symbols-outlined text-lg" id="matchIcon">check_circle</span>
                        <span id="matchText">Şifreler eşleşiyor</span>
                    </div>

                    <!-- Submit -->
                    <button type="submit"
                            class="w-full bg-gradient-to-r from-amber-500 to-orange-600 hover:from-amber-600 hover:to-orange-700 text-white font-semibold py-3 px-4 rounded-xl transition-all duration-300 flex items-center justify-center gap-2">
                        <span class="material-symbols-outlined">key</span>
                        Şifreyi Değiştir
                    </button>
                </form>
            </div>
        </div>

        <!-- Account Info -->
        <div class="mt-6 bg-gray-800/50 backdrop-blur-sm border border-gray-700/50 rounded-2xl p-6">
            <div class="flex items-center gap-2 mb-4">
                <span class="material-symbols-outlined text-gray-400">info</span>
                <h3 class="text-white font-semibold">Hesap Bilgileri</h3>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div class="bg-gray-900/50 rounded-xl p-4">
                    <p class="text-gray-500 text-xs mb-1">Kullanıcı Adı</p>
                    <p class="text-white font-medium">@admin?.Username</p>
                </div>
                <div class="bg-gray-900/50 rounded-xl p-4">
                    <p class="text-gray-500 text-xs mb-1">Hesap Durumu</p>
                    <div class="flex items-center gap-2">
                        <span class="w-2 h-2 bg-emerald-500 rounded-full"></span>
                        <span class="text-emerald-400 font-medium">Aktif</span>
                    </div>
                </div>
                <div class="bg-gray-900/50 rounded-xl p-4">
                    <p class="text-gray-500 text-xs mb-1">Son Giriş</p>
                    <p class="text-white font-medium">
                        @if (admin?.LastLoginDate != null)
                        {
                            @admin.LastLoginDate.Value.ToString("dd MMMM yyyy, HH:mm")
                        }
                        else
                        {
                            <span class="text-gray-500">-</span>
                        }
                    </p>
                </div>
            </div>
        </div>

    </div>
</div>

<script>
    // Şifre göster/gizle
    function togglePass(inputId, iconId) {
        const input = document.getElementById(inputId);
        const icon = document.getElementById(iconId);

        if (input.type === 'password') {
            input.type = 'text';
            icon.textContent = 'visibility_off';
        } else {
            input.type = 'password';
            icon.textContent = 'visibility';
        }
    }

    // Şifre eşleşme kontrolü
    const newPass = document.getElementById('newPassword');
    const confirmPass = document.getElementById('confirmPassword');
    const matchDiv = document.getElementById('passwordMatch');
    const matchIcon = document.getElementById('matchIcon');
    const matchText = document.getElementById('matchText');

    function checkPasswordMatch() {
        if (confirmPass.value.length > 0) {
            matchDiv.classList.remove('hidden');
            matchDiv.classList.add('flex');

            if (newPass.value === confirmPass.value) {
                matchDiv.classList.remove('text-red-400');
                matchDiv.classList.add('text-emerald-400');
                matchIcon.textContent = 'check_circle';
                matchText.textContent = 'Şifreler eşleşiyor';
            } else {
                matchDiv.classList.remove('text-emerald-400');
                matchDiv.classList.add('text-red-400');
                matchIcon.textContent = 'cancel';
                matchText.textContent = 'Şifreler eşleşmiyor';
            }
        } else {
            matchDiv.classList.add('hidden');
            matchDiv.classList.remove('flex');
        }
    }

    newPass?.addEventListener('input', checkPasswordMatch);
    confirmPass?.addEventListener('input', checkPasswordMatch);

    // Profil resmi önizleme
    const profileImageInput = document.getElementById('profileImageInput');
    profileImageInput?.addEventListener('input', function() {
        const preview = document.getElementById('avatarPreview');
        if (this.value) {
            preview.innerHTML = `<img src="${this.value}" alt="Profile" class="w-full h-full object-cover" onerror="this.parentElement.innerHTML='<div class=\\'w-full h-full bg-gradient-to-br from-cyan-500 to-blue-600 flex items-center justify-center\\'><span class=\\'text-2xl font-bold text-white\\'>?</span></div>'">`;
        }
    });
</script>