@model List<ResumeProjectDemoNight.Entities.SocialMedia>
@{
    ViewData["Title"] = "Sosyal Medya";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<!-- Font Awesome CDN -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<div class="min-h-screen p-6 lg:p-8">
    <div class="max-w-4xl mx-auto">

        <!-- Header Section -->
        <div class="relative mb-10">
            <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6">
                <div>
                    <div class="flex items-center gap-3 mb-3">
                        <div class="w-12 h-12 bg-gradient-to-br from-blue-500 to-indigo-600 rounded-2xl flex items-center justify-center shadow-lg shadow-blue-500/30">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
                            </svg>
                        </div>
                        <div>
                            <h1 class="text-3xl font-bold text-white">Sosyal Medya</h1>
                            <p class="text-gray-400 mt-1">Sosyal medya hesaplarınızı yönetin</p>
                        </div>
                    </div>
                </div>

                <a href="/SocialMedia/CreateSocialMedia/"
                   class="group relative inline-flex items-center gap-2 bg-gradient-to-r from-blue-500 to-indigo-600 text-white font-semibold px-6 py-3 rounded-2xl transition-all duration-300 shadow-lg shadow-blue-500/25 hover:shadow-xl hover:shadow-blue-500/40 hover:-translate-y-0.5 overflow-hidden">
                    <span class="absolute inset-0 bg-gradient-to-r from-blue-400 to-indigo-500 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></span>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 relative z-10" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
                    </svg>
                    <span class="relative z-10">Yeni Hesap Ekle</span>
                </a>
            </div>

            <div class="absolute -top-4 -right-4 w-24 h-24 bg-blue-500/10 rounded-full blur-2xl"></div>
            <div class="absolute -bottom-4 -left-4 w-32 h-32 bg-indigo-500/10 rounded-full blur-2xl"></div>
        </div>

        <!-- Success/Error Messages -->
        @if (TempData["Success"] != null)
        {
            <div class="mb-6 bg-green-500/10 border border-green-500/50 rounded-xl p-4 flex items-center gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-green-400 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                <span class="text-green-400">@TempData["Success"]</span>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="mb-6 bg-red-500/10 border border-red-500/50 rounded-xl p-4 flex items-center gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-red-400 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                </svg>
                <span class="text-red-400">@TempData["Error"]</span>
            </div>
        }

        <!-- Social Media List -->
        @if (Model.Any())
        {
            <div class="space-y-4">
                @foreach (var item in Model)
                {
                    <div class="group relative bg-gray-800/40 backdrop-blur-sm border border-gray-700/50 rounded-2xl p-5 hover:border-blue-500/50 transition-all duration-300 hover:shadow-xl hover:shadow-black/20">
                        <div class="flex items-center gap-5">

                            <!-- Icon -->
                            <div class="w-14 h-14 bg-gradient-to-br from-gray-600/20 to-gray-700/20 rounded-xl flex items-center justify-center border border-gray-500/30 group-hover:scale-110 transition-transform duration-300">
                                @if (item.Image.Contains("github"))
                                {
                                    <i class="@item.Image text-2xl text-white"></i>
                                }
                                else if (item.Image.Contains("linkedin"))
                                {
                                    <i class="@item.Image text-2xl text-blue-400"></i>
                                }
                                else if (item.Image.Contains("youtube"))
                                {
                                    <i class="@item.Image text-2xl text-red-500"></i>
                                }
                                else if (item.Image.Contains("twitter") || item.Image.Contains("x-twitter"))
                                {
                                    <i class="@item.Image text-2xl text-sky-400"></i>
                                }
                                else if (item.Image.Contains("instagram"))
                                {
                                    <i class="@item.Image text-2xl text-pink-500"></i>
                                }
                                else if (item.Image.Contains("facebook"))
                                {
                                    <i class="@item.Image text-2xl text-blue-500"></i>
                                }
                                else if (item.Image.Contains("discord"))
                                {
                                    <i class="@item.Image text-2xl text-indigo-400"></i>
                                }
                                else if (item.Image.Contains("twitch"))
                                {
                                    <i class="@item.Image text-2xl text-purple-500"></i>
                                }
                                else
                                {
                                    <i class="@item.Image text-2xl text-gray-300"></i>
                                }
                            </div>

                            <!-- URL -->
                            <div class="flex-1 min-w-0">
                                <a href="@item.SocialMediaURL" target="_blank" class="text-white font-medium hover:text-blue-400 transition-colors truncate block">
                                    @item.SocialMediaURL
                                </a>
                                <p class="text-gray-500 text-sm mt-1">@item.Image</p>
                            </div>

                            <!-- Actions -->
                            <div class="flex items-center gap-2">
                                <a href="@item.SocialMediaURL"
                                   target="_blank"
                                   class="w-10 h-10 rounded-xl bg-gray-700/50 text-gray-400 hover:bg-blue-500/20 hover:text-blue-400 flex items-center justify-center transition-all"
                                   title="Ziyaret Et">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                                    </svg>
                                </a>
                                <a href="/SocialMedia/UpdateSocialMedia/@item.SocialMediaId"
                                   class="w-10 h-10 rounded-xl bg-gray-700/50 text-amber-400 hover:bg-amber-500/20 flex items-center justify-center transition-all"
                                   title="Düzenle">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                                        <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" />
                                    </svg>
                                </a>
                                <a href="/SocialMedia/DeleteSocialMedia/@item.SocialMediaId"
                                   class="w-10 h-10 rounded-xl bg-gray-700/50 text-red-400 hover:bg-red-500/20 flex items-center justify-center transition-all"
                                   title="Sil"
                                   onclick="return confirm('Bu sosyal medya hesabını silmek istediğinizden emin misiniz?')">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                                        <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
                                    </svg>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        <!-- Empty State -->
        @if (!Model.Any())
        {
            <div class="relative bg-gray-800/40 backdrop-blur-sm border border-gray-700/50 border-dashed rounded-2xl p-12 text-center">
                <div class="absolute inset-0 bg-gradient-to-br from-blue-500/5 to-indigo-500/5 rounded-2xl"></div>
                <div class="relative z-10">
                    <div class="w-20 h-20 bg-gray-800 rounded-2xl flex items-center justify-center mx-auto mb-6 border border-gray-700">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
                        </svg>
                    </div>
                    <h3 class="text-xl font-bold text-white mb-2">Henüz sosyal medya hesabı eklenmemiş</h3>
                    <p class="text-gray-400 mb-8 max-w-md mx-auto">Sosyal medya hesaplarınızı ekleyerek ziyaretçilerinizin sizinle iletişime geçmesini kolaylaştırın.</p>
                    <a href="/SocialMedia/CreateSocialMedia/" class="inline-flex items-center gap-2 bg-gradient-to-r from-blue-500 to-indigo-600 text-white font-semibold px-8 py-3.5 rounded-xl">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
                        </svg>
                        İlk Hesabı Ekle
                    </a>
                </div>
            </div>
        }

        <!-- Footer Stats -->
        @if (Model.Any())
        {
            <div class="mt-8 flex items-center justify-center">
                <div class="inline-flex items-center gap-4 px-6 py-3 bg-gray-800/40 backdrop-blur-sm rounded-full border border-gray-700/50">
                    <div class="flex items-center gap-2">
                        <span class="relative flex h-2 w-2">
                            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"></span>
                            <span class="relative inline-flex rounded-full h-2 w-2 bg-blue-500"></span>
                        </span>
                        <span class="text-gray-400 text-sm">Aktif</span>
                    </div>
                    <div class="w-px h-4 bg-gray-700"></div>
                    <span class="text-gray-300 text-sm font-medium">
                        <span class="text-blue-400">@Model.Count</span> sosyal medya hesabı
                    </span>
                </div>
            </div>
        }
    </div>
</div>