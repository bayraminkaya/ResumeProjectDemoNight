@model ResumeProjectDemoNight.Entities.SocialMedia
@{
    ViewData["Title"] = "Sosyal Medya Düzenle";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<!-- Font Awesome CDN -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<div class="min-h-screen p-6 lg:p-8">
    <div class="max-w-2xl mx-auto">

        <!-- Header -->
        <div class="mb-8">
            <a href="/SocialMedia/SocialMediaList/" class="inline-flex items-center gap-2 text-gray-400 hover:text-white transition-colors mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
                </svg>
                Sosyal Medya Listesine Dön
            </a>
            <div class="flex items-center gap-3">
                <div class="w-12 h-12 bg-gradient-to-br from-amber-500 to-orange-500 rounded-2xl flex items-center justify-center shadow-lg shadow-amber-500/30">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" viewBox="0 0 20 20" fill="currentColor">
                        <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" />
                    </svg>
                </div>
                <div>
                    <h1 class="text-2xl font-bold text-white">Sosyal Medya Düzenle</h1>
                    <p class="text-gray-400 text-sm">@Model.SocialMediaURL</p>
                </div>
            </div>
        </div>

        <!-- Form Card -->
        <form asp-action="UpdateSocialMedia" method="post">
            <input type="hidden" asp-for="SocialMediaId" />

            <div class="bg-gray-800/40 backdrop-blur-sm border border-gray-700/50 rounded-2xl p-6 lg:p-8 space-y-6">

                <!-- URL -->
                <div>
                    <label class="block text-sm font-medium text-gray-300 mb-2">
                        Profil URL'si <span class="text-red-400">*</span>
                    </label>
                    <input type="url"
                           asp-for="SocialMediaURL"
                           id="urlInput"
                           placeholder="https://github.com/kullaniciadi"
                           class="w-full bg-gray-900/50 border border-gray-600 rounded-xl px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all"
                           required>
                </div>

                <!-- Icon -->
                <div>
                    <label class="block text-sm font-medium text-gray-300 mb-2">
                        İkon Sınıfı <span class="text-red-400">*</span>
                    </label>
                    <input type="text"
                           asp-for="Image"
                           id="iconInput"
                           placeholder="fab fa-github"
                           class="w-full bg-gray-900/50 border border-gray-600 rounded-xl px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all"
                           required>

                    <!-- Quick Icon Selection -->
                    <div class="mt-4">
                        <p class="text-gray-500 text-xs mb-3">Popüler platformlar:</p>
                        <div class="grid grid-cols-4 sm:grid-cols-6 gap-3">
                            <button type="button" onclick="setIcon('fab fa-github')" class="group flex flex-col items-center gap-2 p-3 bg-gray-700/50 hover:bg-gray-600/50 rounded-xl transition-all" title="GitHub">
                                <i class="fab fa-github text-2xl text-gray-400 group-hover:text-white"></i>
                                <span class="text-xs text-gray-500 group-hover:text-gray-300">GitHub</span>
                            </button>
                            <button type="button" onclick="setIcon('fab fa-linkedin')" class="group flex flex-col items-center gap-2 p-3 bg-gray-700/50 hover:bg-blue-500/20 rounded-xl transition-all" title="LinkedIn">
                                <i class="fab fa-linkedin text-2xl text-gray-400 group-hover:text-blue-400"></i>
                                <span class="text-xs text-gray-500 group-hover:text-gray-300">LinkedIn</span>
                            </button>
                            <button type="button" onclick="setIcon('fab fa-youtube')" class="group flex flex-col items-center gap-2 p-3 bg-gray-700/50 hover:bg-red-500/20 rounded-xl transition-all" title="YouTube">
                                <i class="fab fa-youtube text-2xl text-gray-400 group-hover:text-red-500"></i>
                                <span class="text-xs text-gray-500 group-hover:text-gray-300">YouTube</span>
                            </button>
                            <button type="button" onclick="setIcon('fa-brands fa-x-twitter')" class="group flex flex-col items-center gap-2 p-3 bg-gray-700/50 hover:bg-gray-600/50 rounded-xl transition-all" title="X (Twitter)">
                                <i class="fab fa-x-twitter text-2xl text-gray-400 group-hover:text-white"></i>
                                <span class="text-xs text-gray-500 group-hover:text-gray-300">X</span>
                            </button>
                            <button type="button" onclick="setIcon('fab fa-instagram')" class="group flex flex-col items-center gap-2 p-3 bg-gray-700/50 hover:bg-pink-500/20 rounded-xl transition-all" title="Instagram">
                                <i class="fab fa-instagram text-2xl text-gray-400 group-hover:text-pink-500"></i>
                                <span class="text-xs text-gray-500 group-hover:text-gray-300">Instagram</span>
                            </button>
                            <button type="button" onclick="setIcon('fab fa-facebook')" class="group flex flex-col items-center gap-2 p-3 bg-gray-700/50 hover:bg-blue-600/20 rounded-xl transition-all" title="Facebook">
                                <i class="fab fa-facebook text-2xl text-gray-400 group-hover:text-blue-500"></i>
                                <span class="text-xs text-gray-500 group-hover:text-gray-300">Facebook</span>
                            </button>
                            <button type="button" onclick="setIcon('fab fa-discord')" class="group flex flex-col items-center gap-2 p-3 bg-gray-700/50 hover:bg-indigo-500/20 rounded-xl transition-all" title="Discord">
                                <i class="fab fa-discord text-2xl text-gray-400 group-hover:text-indigo-400"></i>
                                <span class="text-xs text-gray-500 group-hover:text-gray-300">Discord</span>
                            </button>
                            <button type="button" onclick="setIcon('fab fa-twitch')" class="group flex flex-col items-center gap-2 p-3 bg-gray-700/50 hover:bg-purple-500/20 rounded-xl transition-all" title="Twitch">
                                <i class="fab fa-twitch text-2xl text-gray-400 group-hover:text-purple-500"></i>
                                <span class="text-xs text-gray-500 group-hover:text-gray-300">Twitch</span>
                            </button>
                            <button type="button" onclick="setIcon('fab fa-tiktok')" class="group flex flex-col items-center gap-2 p-3 bg-gray-700/50 hover:bg-gray-600/50 rounded-xl transition-all" title="TikTok">
                                <i class="fab fa-tiktok text-2xl text-gray-400 group-hover:text-white"></i>
                                <span class="text-xs text-gray-500 group-hover:text-gray-300">TikTok</span>
                            </button>
                            <button type="button" onclick="setIcon('fab fa-spotify')" class="group flex flex-col items-center gap-2 p-3 bg-gray-700/50 hover:bg-green-500/20 rounded-xl transition-all" title="Spotify">
                                <i class="fab fa-spotify text-2xl text-gray-400 group-hover:text-green-500"></i>
                                <span class="text-xs text-gray-500 group-hover:text-gray-300">Spotify</span>
                            </button>
                            <button type="button" onclick="setIcon('fab fa-dribbble')" class="group flex flex-col items-center gap-2 p-3 bg-gray-700/50 hover:bg-pink-500/20 rounded-xl transition-all" title="Dribbble">
                                <i class="fab fa-dribbble text-2xl text-gray-400 group-hover:text-pink-400"></i>
                                <span class="text-xs text-gray-500 group-hover:text-gray-300">Dribbble</span>
                            </button>
                            <button type="button" onclick="setIcon('fab fa-behance')" class="group flex flex-col items-center gap-2 p-3 bg-gray-700/50 hover:bg-blue-500/20 rounded-xl transition-all" title="Behance">
                                <i class="fab fa-behance text-2xl text-gray-400 group-hover:text-blue-400"></i>
                                <span class="text-xs text-gray-500 group-hover:text-gray-300">Behance</span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Preview -->
                <div class="pt-4 border-t border-gray-700/50">
                    <label class="block text-sm font-medium text-gray-300 mb-3">Önizleme</label>
                    <div class="bg-gray-900/50 rounded-xl p-5 border border-gray-700/50">
                        <div class="flex items-center gap-4">
                            <div id="previewIconWrapper" class="w-14 h-14 bg-gradient-to-br from-gray-500/20 to-gray-600/20 rounded-xl flex items-center justify-center border border-gray-500/30">
                                <i id="previewIcon" class="@Model.Image text-2xl text-gray-300"></i>
                            </div>
                            <div class="flex-1 min-w-0">
                                <p id="previewUrl" class="text-white font-medium truncate">@Model.SocialMediaURL</p>
                                <p id="previewIconClass" class="text-gray-500 text-sm">@Model.Image</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Buttons -->
                <div class="flex gap-4 pt-4">
                    <button type="submit"
                            class="flex-1 inline-flex items-center justify-center gap-2 bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-600 hover:to-orange-600 text-white font-semibold px-6 py-3.5 rounded-xl transition-all duration-300 shadow-lg shadow-amber-500/25">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                            <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" />
                        </svg>
                        Değişiklikleri Kaydet
                    </button>
                    <a href="/SocialMedia/SocialMediaList/"
                       class="px-6 py-3.5 bg-gray-700 hover:bg-gray-600 text-gray-300 font-medium rounded-xl transition-all">
                        İptal
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

<script>
    const urlInput = document.getElementById('urlInput');
    const iconInput = document.getElementById('iconInput');
    const previewUrl = document.getElementById('previewUrl');
    const previewIcon = document.getElementById('previewIcon');
    const previewIconClass = document.getElementById('previewIconClass');

    urlInput?.addEventListener('input', function() {
        previewUrl.textContent = this.value || 'https://github.com/kullaniciadi';
    });

    iconInput?.addEventListener('input', function() {
        updatePreview(this.value);
    });

    function setIcon(iconClass) {
        iconInput.value = iconClass;
        updatePreview(iconClass);
    }

    function updatePreview(iconClass) {
        previewIcon.className = iconClass + ' text-2xl';
        previewIconClass.textContent = iconClass;

        previewIcon.classList.remove('text-gray-300', 'text-blue-400', 'text-blue-500', 'text-red-500', 'text-pink-500', 'text-purple-500', 'text-indigo-400', 'text-green-500', 'text-white');

        if (iconClass.includes('github') || iconClass.includes('x-twitter') || iconClass.includes('tiktok')) {
            previewIcon.classList.add('text-white');
        } else if (iconClass.includes('linkedin') || iconClass.includes('behance')) {
            previewIcon.classList.add('text-blue-400');
        } else if (iconClass.includes('youtube')) {
            previewIcon.classList.add('text-red-500');
        } else if (iconClass.includes('instagram') || iconClass.includes('dribbble')) {
            previewIcon.classList.add('text-pink-500');
        } else if (iconClass.includes('twitch')) {
            previewIcon.classList.add('text-purple-500');
        } else if (iconClass.includes('discord')) {
            previewIcon.classList.add('text-indigo-400');
        } else if (iconClass.includes('spotify')) {
            previewIcon.classList.add('text-green-500');
        } else if (iconClass.includes('facebook')) {
            previewIcon.classList.add('text-blue-500');
        } else {
            previewIcon.classList.add('text-gray-300');
        }
    }

    // Sayfa yüklendiğinde önizlemeyi güncelle
    document.addEventListener('DOMContentLoaded', function() {
        updatePreview('@Model.Image');
    });
</script>