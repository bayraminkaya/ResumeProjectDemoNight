@model ResumeProjectDemoNight.Entities.Skill
@{
    ViewData["Title"] = "Yetenek Düzenle";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="min-h-screen p-6 lg:p-8">
    <div class="max-w-2xl mx-auto">

        <!-- Header -->
        <div class="mb-8">
            <a href="/Skill/SkillList/" class="inline-flex items-center gap-2 text-gray-400 hover:text-white transition-colors mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
                </svg>
                Yeteneklere Dön
            </a>
            <div class="flex items-center gap-3">
                <div class="w-12 h-12 bg-gradient-to-br from-amber-500 to-orange-500 rounded-2xl flex items-center justify-center shadow-lg shadow-amber-500/30">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" viewBox="0 0 20 20" fill="currentColor">
                        <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" />
                    </svg>
                </div>
                <div>
                    <h1 class="text-2xl font-bold text-white">Yetenek Düzenle</h1>
                    <p class="text-gray-400 text-sm">@Model.SkillName yetenekini düzenliyorsunuz</p>
                </div>
            </div>
        </div>

        <!-- Form Card -->
        <form asp-action="UpdateSkill" method="post">
            <input type="hidden" asp-for="SkillId" />

            <div class="bg-gray-800/40 backdrop-blur-sm border border-gray-700/50 rounded-2xl p-6 lg:p-8 space-y-6">

                <!-- Skill Name -->
                <div>
                    <label class="block text-sm font-medium text-gray-300 mb-2">
                        Yetenek Adı <span class="text-red-400">*</span>
                    </label>
                    <input type="text"
                           asp-for="SkillName"
                           placeholder="Örn: Full Stack Geliştirme"
                           class="w-full bg-gray-900/50 border border-gray-600 rounded-xl px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 transition-all"
                           required>
                </div>

                <!-- Skill Degree -->
                <div>
                    <label class="block text-sm font-medium text-gray-300 mb-2">
                        Yetenek Seviyesi <span class="text-red-400">*</span>
                    </label>
                    <div class="space-y-3">
                        <input type="range"
                               asp-for="SkillDegree"
                               id="skillDegreeRange"
                               min="0"
                               max="100"
                               class="w-full h-2 bg-gray-700 rounded-lg appearance-none cursor-pointer accent-cyan-500">
                        <div class="flex items-center justify-between">
                            <span class="text-xs text-gray-500">Başlangıç</span>
                            <span id="degreeValue" class="text-lg font-bold text-cyan-400">@Model.SkillDegree%</span>
                            <span class="text-xs text-gray-500">Uzman</span>
                        </div>
                    </div>
                </div>

                <!-- Skill Color -->
                <div>
                    <label class="block text-sm font-medium text-gray-300 mb-2">
                        Renk Kodu <span class="text-red-400">*</span>
                    </label>
                    <div class="flex items-center gap-4">
                        <div class="flex-1 relative">
                            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-500">#</span>
                            <input type="text"
                                   asp-for="SkillColor"
                                   id="colorInput"
                                   placeholder="6C6CE5"
                                   maxlength="6"
                                   class="w-full bg-gray-900/50 border border-gray-600 rounded-xl pl-8 pr-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 transition-all uppercase"
                                   required>
                        </div>
                        <input type="color"
                               id="colorPicker"
                               value="#@Model.SkillColor"
                               class="w-14 h-12 rounded-xl border-2 border-gray-600 cursor-pointer bg-transparent">
                    </div>
                    <!-- Preset Colors -->
                    <div class="flex items-center gap-2 mt-3">
                        <span class="text-xs text-gray-500 mr-2">Hızlı seçim:</span>
                        <button type="button" onclick="setColor('6C6CE5')" class="w-8 h-8 rounded-lg hover:scale-110 transition-transform" style="background-color: #6C6CE5;"></button>
                        <button type="button" onclick="setColor('FFD15C')" class="w-8 h-8 rounded-lg hover:scale-110 transition-transform" style="background-color: #FFD15C;"></button>
                        <button type="button" onclick="setColor('44D7B6')" class="w-8 h-8 rounded-lg hover:scale-110 transition-transform" style="background-color: #44D7B6;"></button>
                        <button type="button" onclick="setColor('FF4C60')" class="w-8 h-8 rounded-lg hover:scale-110 transition-transform" style="background-color: #FF4C60;"></button>
                        <button type="button" onclick="setColor('A29BFE')" class="w-8 h-8 rounded-lg hover:scale-110 transition-transform" style="background-color: #A29BFE;"></button>
                        <button type="button" onclick="setColor('00CEC9')" class="w-8 h-8 rounded-lg hover:scale-110 transition-transform" style="background-color: #00CEC9;"></button>
                    </div>
                </div>

                <!-- Preview -->
                <div class="pt-4 border-t border-gray-700/50">
                    <label class="block text-sm font-medium text-gray-300 mb-3">Önizleme</label>
                    <div class="bg-gray-900/50 rounded-xl p-4">
                        <div class="flex items-center justify-between mb-2">
                            <span id="previewName" class="text-white font-medium">@Model.SkillName</span>
                            <span id="previewDegree" class="font-bold" style="color: #@Model.SkillColor;">@Model.SkillDegree%</span>
                        </div>
                        <div class="h-3 bg-gray-700 rounded-full overflow-hidden">
                            <div id="previewBar" class="h-full rounded-full transition-all duration-300" style="width: @(Model.SkillDegree)%; background-color: #@Model.SkillColor;"></div>
                        </div>
                    </div>
                </div>

                <!-- Buttons -->
                <div class="flex gap-4 pt-4">
                    <button type="submit"
                            class="flex-1 inline-flex items-center justify-center gap-2 bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-600 hover:to-orange-600 text-white font-semibold px-6 py-3.5 rounded-xl transition-all duration-300 shadow-lg shadow-amber-500/25">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                            <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" />
                        </svg>
                        Değişiklikleri Kaydet
                    </button>
                    <a href="/Skill/SkillList/"
                       class="px-6 py-3.5 bg-gray-700 hover:bg-gray-600 text-gray-300 font-medium rounded-xl transition-all">
                        İptal
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

<script>
    const nameInput = document.querySelector('input[name="SkillName"]');
    const degreeRange = document.getElementById('skillDegreeRange');
    const degreeValue = document.getElementById('degreeValue');
    const colorInput = document.getElementById('colorInput');
    const colorPicker = document.getElementById('colorPicker');

    const previewName = document.getElementById('previewName');
    const previewDegree = document.getElementById('previewDegree');
    const previewBar = document.getElementById('previewBar');

    // Name preview
    nameInput?.addEventListener('input', function() {
        previewName.textContent = this.value || 'Yetenek Adı';
    });

    // Degree preview
    degreeRange?.addEventListener('input', function() {
        const value = this.value;
        degreeValue.textContent = value + '%';
        previewDegree.textContent = value + '%';
        previewBar.style.width = value + '%';
    });

    // Color input sync
    colorInput?.addEventListener('input', function() {
        const color = this.value.replace('#', '');
        if (color.length === 6) {
            colorPicker.value = '#' + color;
            updateColorPreview(color);
        }
    });

    colorPicker?.addEventListener('input', function() {
        const color = this.value.replace('#', '').toUpperCase();
        colorInput.value = color;
        updateColorPreview(color);
    });

    function setColor(color) {
        colorInput.value = color;
        colorPicker.value = '#' + color;
        updateColorPreview(color);
    }

    function updateColorPreview(color) {
        previewDegree.style.color = '#' + color;
        previewBar.style.backgroundColor = '#' + color;
    }
</script>