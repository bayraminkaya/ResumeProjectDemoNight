@model List<ResumeProjectDemoNight.Entities.Certificate>

@if (Model.Any())
{
    <section id="certificates">
        <div class="container">
            <h2 class="section-title wow fadeInUp">Sertifikalarım</h2>
            <div class="spacer" data-height="60"></div>

            <div class="row">
                @foreach (var cert in Model)
                {
                    <div class="col-md-4 col-sm-6 mb-4">
                        <div class="certificate-card bg-white rounded shadow-dark p-4 h-100 wow fadeInUp" style="transition: all 0.3s ease;">
                            <div class="d-flex align-items-start mb-3">
                                <div class="cert-icon mr-3" style="width: 50px; height: 50px; background: linear-gradient(135deg, #FF4C60, #ff6b7a); border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                                    @if (!string.IsNullOrEmpty(cert.IconUrl))
                                    {
                                        <i class="@cert.IconUrl text-white" style="font-size: 22px;"></i>
                                    }
                                    else
                                    {
                                        <i class="fas fa-certificate text-white" style="font-size: 22px;"></i>
                                    }
                                </div>
                                <div class="flex-grow-1">
                                    <h5 class="mb-1 font-weight-bold" style="color: #353353; font-size: 16px; line-height: 1.4;">@cert.Name</h5>
                                    <span class="text-primary font-weight-bold" style="font-size: 13px; color: #FF4C60 !important;">@cert.Issuer</span>
                                </div>
                            </div>

                            <div class="d-flex align-items-center justify-content-between mt-auto pt-3" style="border-top: 1px solid #eee;">
                                <span class="text-muted" style="font-size: 12px;">
                                    <i class="far fa-calendar-alt mr-1"></i> @cert.IssueDate
                                </span>
                                @if (!string.IsNullOrEmpty(cert.CredentialUrl))
                                {
                                    <a href="@cert.CredentialUrl" target="_blank" class="btn-verify" style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: #6C6CE5; letter-spacing: 0.5px; display: inline-flex; align-items: center; text-decoration: none; transition: 0.3s;">
                                        <i class="fas fa-external-link-alt mr-1"></i> Doğrula
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    <style>
        .certificate-card {
            position: relative;
            overflow: hidden;
        }

            .certificate-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 4px;
                background: linear-gradient(90deg, #FF4C60, #6C6CE5);
                transform: scaleX(0);
                transition: transform 0.3s ease;
            }

            .certificate-card:hover::before {
                transform: scaleX(1);
            }

            .certificate-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 15px 30px rgba(0,0,0,0.1) !important;
            }

        .btn-verify:hover {
            color: #FF4C60 !important;
        }
    </style>
}