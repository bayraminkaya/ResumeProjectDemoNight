@model List<ResumeProjectDemoNight.Entities.Service>

@{
    
    var colors = new[] { "#6C6CE5", "#F9D74C", "#F97B8B" };
    var shadows = new[] { "shadow-blue", "shadow-yellow", "shadow-pink" };
    int count = 0;
}

<section id="services">
    <div class="container">
        <h2 class="section-title wow fadeInUp">Hizmetlerim</h2>
        <div class="spacer" data-height="60"></div>

        <div class="row">
            @foreach (var item in Model)
            {
                var currentColor = colors[count % colors.Length];
                var currentShadow = shadows[count % shadows.Length];

                string textColorClass = (count % colors.Length == 1) ? "text-dark" : "text-light";

                <div class="col-md-4">
                    <div class="service-box rounded data-background padding-30 text-center @textColorClass @currentShadow"
                         data-color="@currentColor">
                        <img src="@item.ImageUrl" alt="@item.Title" style="width: 80px; height: 80px; margin-bottom: 20px;" />
                        <h3 class="mb-3 mt-0">@item.Title</h3>
                        <p class="mb-0">@item.Description</p>
                    </div>
                    <div class="spacer d-md-none d-lg-none" data-height="30"></div>
                </div>

                count++;
            }
        </div>

        <div class="mt-5 text-center">
            <p class="mb-0">Bir projeniz mi var? <a href="#contact" style="color: #ff4c60; font-weight: bold;">Buradan</a> bana yazın! 👋</p>
        </div>
    </div>
</section>