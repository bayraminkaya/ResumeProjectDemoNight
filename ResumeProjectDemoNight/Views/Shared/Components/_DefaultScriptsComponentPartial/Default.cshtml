<!-- Google Translate -->
<script type="text/javascript">
    function googleTranslateElementInit() {
        new google.translate.TranslateElement({
            pageLanguage: 'tr',
            includedLanguages: 'en,de,tr',
            autoDisplay: false
        }, 'google_translate_element');
    }

    function setLanguage(lang) {
        // Bayrak aktifliğini güncelle
        var allFlags = document.querySelectorAll('.lang-img');
        for (var i = 0; i < allFlags.length; i++) {
            allFlags[i].classList.remove('active');
        }
        var activeFlag = document.getElementById('lang-' + lang);
        if (activeFlag) {
            activeFlag.classList.add('active');
        }

        // Dil tercihini kaydet
        localStorage.setItem('selectedLang', lang);

        // Cookie ile dil ayarla
        var domain = window.location.hostname;

        if (lang === 'tr') {
            // Türkçe - çeviriyi kaldır
            document.cookie = "googtrans=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/";
            document.cookie = "googtrans=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/; domain=" + domain;
            document.cookie = "googtrans=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/; domain=." + domain;
        } else {
            // Diğer diller
            document.cookie = "googtrans=/tr/" + lang + "; path=/";
            document.cookie = "googtrans=/tr/" + lang + "; path=/; domain=" + domain;
            document.cookie = "googtrans=/tr/" + lang + "; path=/; domain=." + domain;
        }

        // Sayfayı yenile
        window.location.reload();
    }

    // Sayfa yüklendiğinde kayıtlı dili işaretle
    document.addEventListener('DOMContentLoaded', function() {
        var savedLang = localStorage.getItem('selectedLang') || 'tr';
        var activeFlag = document.getElementById('lang-' + savedLang);
        if (activeFlag) {
            activeFlag.classList.add('active');
        }
    });

    // Google Translate toolbar'ı sürekli gizle
    setInterval(function() {
        var frame = document.querySelector('.goog-te-banner-frame');
        if (frame) {
            frame.style.display = 'none';
        }
        var body = document.body;
        if (body) {
            body.style.top = '0px';
        }
    }, 100);
</script>

<script type="text/javascript" src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>

<div id="google_translate_element" style="display:none !important; visibility:hidden !important; height:0 !important;"></div>

