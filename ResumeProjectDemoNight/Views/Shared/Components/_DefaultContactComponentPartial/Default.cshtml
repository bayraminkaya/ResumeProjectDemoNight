@model ResumeProjectDemoNight.Entities.Message

<section id="contact" style="min-height: 100vh; padding-bottom: 150px;">


	<div class="container">

		<!-- section title -->
		<h2 class="section-title wow fadeInUp">Bana Yazın</h2>

		<div class="spacer" data-height="60"></div>

		<div class="row">

			<div class="col-md-4">
				<!-- contact info -->
				<div class="contact-info">
					<h3 class="wow fadeInUp">Her şey hakkında konuşalım!</h3>
					<p class="wow fadeInUp">Formları sevmiyor musunuz? Bana bir <a href="mailto:info@bayraminkaya.com">mail gönder</a>. 👋</p>
				</div>
			</div>

			<div class="col-md-8">
				<!-- Contact Form -->
				<form class="contact-form mt-6" method="post" action="/Default/SendMessage" id="msgForm">

					<div class="messages"></div>

					<div class="row">
						<div class="column col-md-6">
							<!-- Name input -->
							<div class="form-group">
								<input type="text" class="form-control" asp-for="NameSurname" placeholder="Adınız Soyadınız" required="required">
								<div class="help-block with-errors"></div>
							</div>
						</div>

						<div class="column col-md-6">
							<!-- Email input -->
							<div class="form-group">
								<input type="email" class="form-control" asp-for="Email" placeholder="E-posta Adresiniz" required="required">
								<div class="help-block with-errors"></div>
							</div>
						</div>

						<div class="column col-md-12">
							<!-- Email input -->
							<div class="form-group">
								<input type="text" class="form-control" asp-for="Subject" placeholder="Konu" required="required">
								<div class="help-block with-errors"></div>
							</div>
						</div>

						<div class="column col-md-12">
							<!-- Message textarea -->
							<div class="form-group">
								<textarea asp-for="MessageDetail" class="form-control" rows="5" placeholder="Mesajınız" required="required"></textarea>
								<div class="help-block with-errors"></div>
							</div>
						</div>
					</div>

					<button type="submit" class="btn btn-default">Mesaj Gönder</button>

				</form>
				<!-- Contact Form end -->
			</div>

		</div>

	</div>

</section>