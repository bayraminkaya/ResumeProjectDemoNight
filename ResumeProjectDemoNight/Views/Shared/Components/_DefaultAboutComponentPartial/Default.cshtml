@model ResumeProjectDemoNight.Entities.About

<section id="about">

	<div class="container">

		<!-- section title -->
		<h2 class="section-title wow fadeInUp">Hakkımda</h2>

		<div class="spacer" data-height="40"></div>

		<div class="row">

			<div class="row align-items-start">
				<div class="col-md-3">
					<div class="text-center">
						<img src="@Model.ImageUrl" alt="Bayram" class="rounded shadow"
							 style="width: 200px; height: 200px; object-fit: cover;" />
					</div>
				</div>

				<div class="col-md-9 triangle-left-md triangle-top-sm">
					<div class="rounded bg-white shadow-dark padding-30">
						<div class="row">
							<div class="col-md-7">
								<p style="font-size: 14px; line-height: 1.6; text-align: justify;">
									@Model.Description
								</p>

								<div class="mt-4 dropdown">
									<button class="btn btn-default dropdown-toggle btn-sm" type="button" id="downloadCV" data-toggle="dropdown">
										Download CV
									</button>
									<div class="dropdown-menu shadow-dark border-0 rounded-3 overflow-hidden p-0">
										<a class="dropdown-item py-3 border-bottom" href="~/files/CV_Bayram_Inkaya_TR.pdf" download>
											<i class="fas fa-language mr-2 text-info"></i> Türkçe Özgeçmiş
										</a>
										<a class="dropdown-item py-3" href="~/files/CV_Bayram_Inkaya_EN.pdf" download>
											<i class="fas fa-globe mr-2 text-success"></i> English Resume
										</a>
									</div>
								</div>
							</div>

							<div class="col-md-5">
								@await Component.InvokeAsync("_DefaultSkillComponentPartial")
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
		<!-- row end -->

		<div class="spacer" data-height="50"></div>


		@await Component.InvokeAsync("_DefaultStatisticComponentPartial")
	</div>

</section>