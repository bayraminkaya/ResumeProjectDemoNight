<!-- Aktif Sayfa JavaScript -->
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const currentPath = window.location.pathname.toLowerCase();
        const sidebarLinks = document.querySelectorAll('.sidebar-link');

        sidebarLinks.forEach(link => {
            const href = link.getAttribute('href').toLowerCase();

            // URL path'i ile href'i karşılaştır
            if (currentPath.includes(href.split('/')[1])) {
                // Aktif stili ekle
                link.classList.remove('text-slate-400');
                link.classList.add('text-white', 'bg-slate-800/50', 'border-l-2', 'border-cyan-500');

                // İkonu doldur
                const icon = link.querySelector('.material-symbols-outlined');
                if (icon) {
                    icon.style.fontVariationSettings = "'FILL' 1";
                }

                // Font weight
                const text = link.querySelector('.text-sm');
                if (text) {
                    text.classList.remove('font-medium');
                    text.classList.add('font-semibold');
                }
            }
        });
    });
</script>