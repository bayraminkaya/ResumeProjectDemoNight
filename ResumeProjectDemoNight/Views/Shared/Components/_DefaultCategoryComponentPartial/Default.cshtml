@model List<ResumeProjectDemoNight.Entities.Category>

<ul class="portfolio-filter list-inline wow fadeInUp">
    <li class="current list-inline-item" data-filter="*">Tümü</li>
    @foreach (var item in Model)
    {
        @* Kategorinin ID'sini benzersiz bir sınıf ismi yapıyoruz (örn: .cat-1, .cat-2) *@
        <li class="list-inline-item" data-filter=".cat-@item.CategoryId">@item.CategoryName</li>
    }
</ul>