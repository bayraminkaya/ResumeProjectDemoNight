@model List<ResumeProjectDemoNight.Entities.Portfolio>

@functions {
    public string ConvertUrlsToLinks(string text)
    {
        if (string.IsNullOrEmpty(text)) return "";

        // Satır atlamalarını <br> ile değiştir
        text = text.Replace("\r\n", "<br>").Replace("\n", "<br>");

        // URL pattern
        var urlPattern = @"((https?:\/\/|www\.)[^\s<]+[^\s<.,;:!?\""'\)\]])";
        var regex = new System.Text.RegularExpressions.Regex(urlPattern, System.Text.RegularExpressions.RegexOptions.IgnoreCase);

        return regex.Replace(text, match =>
        {
            var url = match.Value;
            var href = url.StartsWith("www.") ? "https://" + url : url;
            return $"<a href=\"{href}\" target=\"_blank\" class=\"text-primary\" style=\"color: #6C6CE5 !important; text-decoration: underline;\">{url}</a>";
        });
    }
}

<section id="works">
    <div class="container">
        <h2 class="section-title wow fadeInUp">Projelerim</h2>
        <div class="spacer" data-height="60"></div>

        @await Component.InvokeAsync("_DefaultCategoryComponentPartial")

        <div class="row portfolio-wrapper">
            @{
                var index = 0;
            }
            @foreach (var item in Model)
            {
                <div class="col-md-4 col-sm-6 grid-item cat-@item.CategoryId" data-index="@index" style="@(index >= 6 ? "display: none;" : "")">
                    <a href="javascript:void(0);" data-toggle="modal" data-target="#projectModal-@item.PortfolioId">
                        <div class="portfolio-item rounded shadow-dark">
                            <div class="details">
                                <span class="term">@item.Category?.CategoryName</span>
                                <h4 class="title">@item.ProjectTitle</h4>
                                <span class="more-button"><i class="icon-magnifier-add"></i></span>
                            </div>
                            <div class="thumb">
                                <img src="@item.ImageUrl" alt="@item.ProjectTitle" />
                                <div class="mask"></div>
                            </div>
                        </div>
                    </a>
                </div>
                index++;
            }
        </div>

        @if (Model.Count > 6)
        {
            <div class="load-more text-center mt-4">
                <a href="javascript:void(0);" id="loadMoreBtn" class="btn btn-default">
                    <i class="fas fa-plus mr-2"></i> Daha Fazla Gör
                    <span class="badge ml-2" style="background: rgba(255,255,255,0.2);">@Model.Count proje</span>
                </a>
            </div>
        }
    </div>
</section>

@foreach (var item in Model)
{
    <div class="modal fade" id="projectModal-@item.PortfolioId" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
            <div class="modal-content border-0">
                <div class="modal-body">
                    <button type="button" class="close" data-dismiss="modal" style="position:absolute; right:25px; top:20px; font-size: 30px; z-index: 10;">&times;</button>

                    <div class="row">
                        <div class="col-md-6 mb-4 mb-md-0">
                            <div class="modal-image-container">
                                <img src="@item.ImageUrl" class="project-modal-img" alt="@item.ProjectTitle">
                            </div>
                        </div>

                        <div class="col-md-6">
                            <span class="text-muted small uppercase">@item.Category?.CategoryName</span>
                            <h3 class="font-weight-bold mb-3" style="color: #353353;">@item.ProjectTitle</h3>

                            <div class="mb-3">
                                @if (!string.IsNullOrEmpty(item.TechStack))
                                {
                                    foreach (var tech in item.TechStack.Split(','))
                                    {
                                        <span class="tech-badge">@tech.Trim()</span>
                                    }
                                }
                            </div>

                            <div class="text-muted mb-4" style="text-align: justify; line-height: 1.8; font-size: 14px;">
                                @Html.Raw(ConvertUrlsToLinks(item.Description))
                            </div>

                            @if (!string.IsNullOrEmpty(item.OtherImages))
                            {
                                var imageList = item.OtherImages.Split(',').Select(img => img.Trim()).ToList();

                                <span class="gallery-label"><i class="fas fa-images mr-2"></i>Proje Görselleri</span>
                                <div class="attachment-container" data-gallery-id="gallery-@item.PortfolioId">
                                    @foreach (var img in imageList)
                                    {
                                        <img src="@img" class="attachment-item" alt="Proje Görseli">
                                    }
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(item.GithubUrl))
                            {
                                <div class="mt-4">
                                    <a href="@item.GithubUrl" target="_blank" class="btn btn-default btn-sm">
                                        <i class="fab fa-github mr-2"></i> GitHub'da İncele
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<script>
    document.addEventListener('DOMContentLoaded', function() {
        var loadMoreBtn = document.getElementById('loadMoreBtn');
        if (!loadMoreBtn) return;

        var gridItems = document.querySelectorAll('.portfolio-wrapper .grid-item');
        var initialShow = 6;
        var increment = 3;
        var currentlyShown = initialShow;
        var totalItems = gridItems.length;

        loadMoreBtn.addEventListener('click', function() {
            var newCount = Math.min(currentlyShown + increment, totalItems);

            for (var i = currentlyShown; i < newCount; i++) {
                if (gridItems[i]) {
                    gridItems[i].style.display = '';
                }
            }

            currentlyShown = newCount;

            // Isotope varsa layout'u güncelle
            if (typeof $ !== 'undefined' && $('.portfolio-wrapper').data('isotope')) {
                $('.portfolio-wrapper').isotope('layout');
            }

            // Tüm projeler gösterildiyse butonu değiştir
            if (currentlyShown >= totalItems) {
                loadMoreBtn.innerHTML = '<i class="fas fa-check mr-2"></i> Tüm Projeler Gösteriliyor';
                loadMoreBtn.style.pointerEvents = 'none';
                loadMoreBtn.style.opacity = '0.7';
            }
        });
    });
</script>