@{
    Layout = null;
}
<!DOCTYPE html>
<html class="dark" lang="en">
@await Component.InvokeAsync("_AdminLayoutHeadComponentPartial")
<body class="bg-background-light dark:bg-background-dark text-slate-900 dark:text-slate-100 flex min-h-screen overflow-hidden">
    <!-- Sidebar -->
    @await Component.InvokeAsync("_AdminLayoutSidebarComponentPartial")
    <!-- Main Content -->
    <main class="ml-64 flex-1 flex flex-col h-screen">
        <!-- Top Navbar (Sabit) -->
        @await Component.InvokeAsync("_AdminLayoutNavbarComponentPartial")

        <!-- Scrollable Content Area -->
        <div class="flex-1 overflow-y-auto">
            @RenderBody()
        </div>
    </main>
</body>
</html>